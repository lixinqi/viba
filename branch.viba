# branch.viba — the two switches that make if/else.
#
# Each switch takes the branch value and applies an internal product selector:
# nil * value keeps it, while never * value eliminates it. The surrounding sum
# then drops the eliminated branch.
#
# Both are marked `ParametersLazyEvaluated`, so `interpret` does not compute the
# branch value up front: it hands the host a getter for it, and the switch calls
# that getter only on the branch it takes. That is what makes this if/else and
# not "compute both, then drop one".

# Condition holds: nil * v = v — and v is computed.
# Condition does not hold: never * v = never — and v is never computed.
nil_or_never =
    ParametersLazyEvaluated[
        Any
      <- $env Environment
      <- $condition bool
      <- $v Any
      <- { when condition holds, hand back v; otherwise hand back never }
    ]

# Condition holds: never * v = never — and v is never computed.
# Condition does not hold: nil * v = v — and v is computed.
never_or_nil =
    ParametersLazyEvaluated[
        Any
      <- $env Environment
      <- $condition bool
      <- $v Any
      <- { when condition holds, hand back never; otherwise hand back v }
    ]
