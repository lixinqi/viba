# The tag names the member, and the value it is taken from is also what the member
# is given first: `$tmp_env << args.env` is `args.env.tmp_env << args.env`. The child
# is handed to a host step, because a run answers viba data only.
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

path_of =
    str
  <- $env Env
  <- $where Environment
  <- { where that environment lives }

__impl__ = path_of << $env args.env << $where ($tmp_env << args.env)
