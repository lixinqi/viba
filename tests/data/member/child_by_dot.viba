# The tag form and the dotted form are the same call: the environment is given, and
# the child it names is handed to the same host step so its path can be taken.
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

path_of =
    str
  <- $env Env
  <- $where Environment
  <- { where that environment lives }

__impl__ = path_of << $env args.env << $where (args.env.sub_env << args.env << "child")
