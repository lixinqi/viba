# `$__getattr__ << box << "f" << …` is `box.f << …`: the member is taken by a
# name given as a value, not by a tag on the chain.
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

Box = Object * $f (int <- $box Box <- $env Env <- $x int) * $y int

inc =
    int
  <- $box Box
  <- $env Env
  <- $x int
  <- { add one }

box = Object * $f inc * $y 2
name = "f"
# 实参按它落的那一位给出：`$x` 是 `inc` 自己声明的 tag。
__impl__ = $__getattr__ << box << name << args.env << $x 1
