# `$sub_env << args.env << "child"` is `args.env.sub_env << args.env << "child"`: the tag
# names a member of the first argument, and that value is given to the member first —
# a member of an environment is a plain function of the environment. A run answers
# viba data only, so where that child lives is taken through a host step (`path_of`).
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

path_of =
    str
  <- $env Env
  <- $where Environment
  <- { where that environment lives }

__impl__ = path_of << $env args.env << $where ($sub_env << args.env << "child")
