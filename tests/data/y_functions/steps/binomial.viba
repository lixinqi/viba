# steps/binomial.viba —— 一步 binomial，从 n 个里取 k 个：k 是 0 或 n 等于 k 都得 1，否则两边相加
#
# 条件分三个岔：外面先按 `zero_k` 分一次，剩下的那一侧里再按 `same` 分一次。
# 两个开关都是 `branch` 的那一对；交给 `$get_v` 的得是**一次调用**（内层那个和整份和都用
# `builtin.echo` 包起来），因为那一份要等到环境来了才算。往下那一层要一次自己的子环境，
# 名字在这个文件里给出。
import branch

__decl__ =
    int
  <- $env Env
  <- $binomial Any
  <- $n int
  <- $k int

args = __get_args__ << __decl__

zero_k = eq << $env args.env << $x args.k << $y 0
same = eq << $env args.env << $x args.n << $y args.k
n_below = sub << $env args.env << $x args.n << $y 1
k_below = sub << $env args.env << $x args.k << $y 1
left = args.binomial << ($sub_env << args.env << "left") << $n n_below << $k k_below
right = args.binomial << ($sub_env << args.env << "right") << $n n_below << $k args.k
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond zero_k
      << $get_v (builtin.echo << $x 1))
  | (branch.never_or_echo << $env args.env << $cond zero_k
      << $get_v (builtin.echo << $x (
        Oneof
        | (branch.echo_or_never << $env args.env << $cond same
            << $get_v (builtin.echo << $x 1))
        | (branch.never_or_echo << $env args.env << $cond same
            << $get_v (add << $env args.env << $x left << $y right))
      )))
