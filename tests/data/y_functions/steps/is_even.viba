# steps/is_even.viba —— 一步 is_even，n 是偶数吗：n 小于 1 答累加器是 0 吗，否则往下走一层、把累加器翻一下
#
# `$is_even` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的地址因此是可复现的。
import branch

__decl__ =
    bool
  <- $env Env
  <- $is_even Any
  <- $n int
  <- $acc int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.n << $y 1
below = sub << $env args.env << $x args.n << $y 1
flipped = sub << $env args.env << $x 1 << $y args.acc
deeper = args.is_even << ($sub_env << args.env << "deeper") << $n below << $acc flipped
even = eq << $env args.env << $x args.acc << $y 0

__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x even))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (builtin.echo << $x deeper))
