# steps/triangle.viba —— 一步 triangle，1 到 n 的和：n 小于 1 得 0，否则 n 加下一层
#
# `$triangle` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的数据路径因此是可复现的。
import branch

__decl__ =
    int
  <- $env Env
  <- $triangle Any
  <- $n int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.n << $y 1
below = sub << $env args.env << $x args.n << $y 1
deeper = args.triangle << ($sub_env << args.env << "deeper") << $n below

__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x 0))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (add << $env args.env << $x args.n << $y deeper))
