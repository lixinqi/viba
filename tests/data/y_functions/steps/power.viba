# steps/power.viba —— 一步 power，x 的 n 次方：n 小于 1 得 1，否则 x 乘下一层
#
# `$power` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的数据路径因此是可复现的。
import branch

__decl__ =
    int
  <- $env Env
  <- $power Any
  <- $x int
  <- $n int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.n << $y 1
below = sub << $env args.env << $x args.n << $y 1
deeper = args.power << ($sub_env << args.env << "deeper") << $x args.x << $n below
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x 1))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (mul << $env args.env << $x args.x << $y deeper))
