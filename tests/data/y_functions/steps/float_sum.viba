# steps/float_sum.viba —— 一步 float_sum，n 个 1.0 的和（答的是 float）：n 小于 1 答 0.0，否则下一层加 1.0
#
# `$float_sum` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的地址因此是可复现的。
import branch
import primitives as primitives

__decl__ =
    float
  <- $env Env
  <- $float_sum ...
  <- $n int

args = __get_args__ << __decl__

small = primitives.lt << $env args.env << $x args.n << $y 1
below = primitives.sub << $env args.env << $x args.n << $y 1
deeper = args.float_sum << ($sub_env << args.env << "deeper") << $n below

__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x 0.0))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (primitives.add_f << $env args.env << $x deeper << $y 1.0))
