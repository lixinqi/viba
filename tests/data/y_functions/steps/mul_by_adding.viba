# steps/mul_by_adding.viba —— 一步 mul_by_adding，a 乘 b 用加法做：b 小于 1 答 0，否则 a 加下一层
#
# `$mul_by_adding` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的地址因此是可复现的。
import branch

__decl__ =
    int
  <- $env Env
  <- $mul_by_adding Any
  <- $a int
  <- $b int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.b << $y 1
below = sub << $env args.env << $x args.b << $y 1
deeper = args.mul_by_adding << ($sub_env << args.env << "deeper") << $a args.a << $b below
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x 0))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (add << $env args.env << $x args.a << $y deeper))
