# steps/hanoi.viba —— 一步 hanoi，汉诺塔要搬几步：n 小于 1 答 0，否则下一层的两倍再加一
#
# `$hanoi` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的地址因此是可复现的。
import branch
import primitives as primitives

__decl__ =
    int
  <- $env Env
  <- $hanoi (int <- int)
  <- $n int

args = __get_args__ << __decl__

small = primitives.lt << $env args.env << $x args.n << $y 1
below = primitives.sub << $env args.env << $x args.n << $y 1
deeper = args.hanoi << ($sub_env << args.env << "deeper") << $n below
doubled = primitives.mul << $env args.env << $x 2 << $y deeper

__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x 0))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (primitives.add << $env args.env << $x doubled << $y 1))
