# steps/fib_acc.viba —— 一步 fib_acc，斐波那契用两个累加器往前推：n 小于 1 得头一个，否则两个累加器各往前挪一位
#
# `$fib_acc` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的数据路径因此是可复现的。
import branch

__decl__ =
    int
  <- $env Env
  <- $fib_acc Any
  <- $n int
  <- $a int
  <- $b int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.n << $y 1
below = sub << $env args.env << $x args.n << $y 1
next = add << $env args.env << $x args.a << $y args.b
deeper = args.fib_acc << ($sub_env << args.env << "deeper") << $n below << $a args.b << $b next
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x args.a))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (builtin.echo << $x deeper))
