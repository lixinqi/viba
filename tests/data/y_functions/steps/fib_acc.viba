# steps/fib_acc.viba —— 一步 fib_acc，斐波那契用两个累加器往前推：n 小于 1 答头一个，否则两个累加器各往前挪一位
#
# `$fib_acc` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字写在这个文件里，这次调用的地址因此是可复现的。
import branch
import primitives as primitives

__def__ =
    int
  <- $env Env
  <- $fib_acc (int <- int <- int <- int)
  <- $n int
  <- $a int
  <- $b int

args = __get_args__ << __def__

small = primitives.lt << $env args.env << $x args.n << $y 1
below = primitives.sub << $env args.env << $x args.n << $y 1
next = primitives.add << $env args.env << $x args.a << $y args.b
deeper = args.fib_acc << ($sub_env << args.env << "deeper") << $n below << $a args.b << $b next

__ret__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x args.a))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (builtin.echo << $x deeper))
