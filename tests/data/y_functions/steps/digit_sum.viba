# steps/digit_sum.viba —— 一步 digit_sum，各位数字之和：n 小于 10 得 n，否则末位加前面那些位
#
# `$digit_sum` 是 Y 交回来的那一份"下一层怎么算"，这一层只算自己这一步；往下那一层要一次自己的
# 子环境，名字在这个文件里给出，这次调用的数据路径因此是可复现的。
import branch

__decl__ =
    int
  <- $env Env
  <- $digit_sum Any
  <- $n int

args = __get_args__ << __decl__

small = lt << $env args.env << $x args.n << $y 10
rest = div << $env args.env << $x args.n << $y 10
last = rem << $env args.env << $x args.n << $y 10
deeper = args.digit_sum << ($sub_env << args.env << "deeper") << $n rest

__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond small
      << $get_v (builtin.echo << $x args.n))
  | (branch.never_or_echo << $env args.env << $cond small
      << $get_v (add << $env args.env << $x last << $y deeper))
