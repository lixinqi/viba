# primitives.viba —— 这一批递归函数用到的宿主那几步：比较、加减乘除、取余、浮点加
lt =
    bool <- $env Env <- $x int <- $y int <- { x 小于 y }
eq =
    bool <- $env Env <- $x int <- $y int <- { x 等于 y }
add =
    int <- $env Env <- $x int <- $y int <- { x 加 y }
sub =
    int <- $env Env <- $x int <- $y int <- { x 减 y }
mul =
    int <- $env Env <- $x int <- $y int <- { x 乘 y }
div =
    int <- $env Env <- $x int <- $y int <- { x 整除 y }
rem =
    int <- $env Env <- $x int <- $y int <- { x 除以 y 的余数 }
add_f =
    float <- $env Env <- $x float <- $y float <- { 两个浮点相加 }
