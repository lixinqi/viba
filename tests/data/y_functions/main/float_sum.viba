# main/float_sum.viba —— 用内建目录里的 ycombinator.Y 跑 steps/float_sum：答 4.0
#
# Y 是内建的泛型（`viba/Y/`）：`ycombinator.Y[step]` 就是那一步的不动点，再给环境与这次要跑的实参。
__decl__ =
    float
  <- $env Env

args = __get_args__ << __decl__

import ycombinator
import steps.float_sum as step

__impl__ = ycombinator.Y[step] << args.env << $n 4
