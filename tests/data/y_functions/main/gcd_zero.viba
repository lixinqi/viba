# main/gcd_zero.viba —— 基例当入口：b 是 0，一进来就答 a，答 7
#
# 这一层不该去求值 `rest`（a 除以 b 的余数，b 是 0），也不该往下调一层。两份定义都写在
# steps/gcd.viba 里，而那里的 `__impl__` 只在 b 不是 0 的那一侧用到它俩；定义是按需求值的绑定
# （call-by-need），这一侧不用就不求值，所以这里安全。这一份就是钉这一点的用例。
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

import ycombinator
import steps.gcd as step

__impl__ = ycombinator.Y[step] << args.env << $a 7 << $b 0
