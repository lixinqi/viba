# main/fib_acc.viba —— 用内建目录里的 Y 跑 steps/fib_acc：得 55
#
# Y 住在包的内建目录里（`viba/Y.viba`）：`Y << step` 就是那一步的不动点。它要环境，调用方
# 给一层子环境（`args.env.sub_env << args.env << "Y"`），再给这次要跑的实参。
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

import Y
import steps.fib_acc as step

__impl__ = Y << step << ($sub_env << args.env << "Y") << $n 10 << $a 0 << $b 1