__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch
import right_mod_branch_kept as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x (right << (args.env.tmp_env << args.env))))
    | (
        branch.never_or_echo
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x 42))
__ret__ = x
