import branch
import right_mod_branch_kept as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (true)
        << $get_v (builtin.echo << $x (right << (environ.tmp_sub_env << environ) << ())))
    | (
        branch.never_or_echo
        << $env environ << $cond (true)
        << $get_v (builtin.echo << $x 42))
__ret__ = x
