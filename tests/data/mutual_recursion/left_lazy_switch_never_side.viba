import branch
import right_lazy_switch_never_side as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x right.y))
    | (
        branch.never_or_echo
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x never))
__ret__ = x
