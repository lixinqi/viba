import branch
import right_bl_false_keeps as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 42))
    | (
        branch.never_or_echo
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x right.y))
__ret__ = x
