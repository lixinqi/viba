__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch
import right_slot_name_is_a_value as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x right.f))
    | (
        branch.never_or_echo
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x 0))
__impl__ = x
