import branch
import right_lazy_switch_sum_side as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (true)
        << $get_v (builtin.echo << $x right.y))
    | (
        branch.never_or_echo
        << $env environ << $cond (true)
        << $get_v (builtin.echo << $x 7))
__ret__ = x
