__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch
import right_both_left_keeps_swapped as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (false)
        << $get_v (builtin.echo << $x 42))
    | (
        branch.never_or_echo
        << $env args.env << $cond (false)
        << $get_v (builtin.echo << $x right.y))
__ret__ = x
