__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch
import right_cond_inside_the_kept_side as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (true)
        << $get_v (right.g << $env args.env))
    | (
        branch.never_or_echo
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x 0))
__ret__ = x
