import branch
import right_slot_partial_call_dropped as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (right.f << $a 1))
    | (
        branch.never_or_echo
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 0))
__ret__ = x
