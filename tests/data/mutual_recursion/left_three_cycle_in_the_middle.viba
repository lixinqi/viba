import branch
import right_three_cycle_in_the_middle as right

x =
    Oneof
    | (branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 1))
    | (branch.echo_or_never
        << $env environ << $cond (true)
        << $get_v (builtin.echo << $x right.y))
    | (branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 3))
__ret__ = x
