__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch
import right_cond_calls_the_other_file as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (right.g << $env args.env)
        << $get_v (right.f << $env args.env << $a 1))
    | (
        branch.never_or_echo
        << $env args.env << $cond (right.g << $env args.env)
        << $get_v (builtin.echo << $x 0))
__impl__ = x
