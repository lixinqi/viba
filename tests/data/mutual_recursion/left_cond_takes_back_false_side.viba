__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch
import right_cond_takes_back_false_side as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (false)
        << $get_v (builtin.echo << $x 7))
    | (
        branch.never_or_echo
        << $env args.env << $cond (false)
        << $get_v (right.g << $env args.env))
__impl__ = x
