import branch
import right_mod_branch_dropped as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (right << (environ.tmp_sub_env << environ) << ()))
    | (
        branch.never_or_echo
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 42))
__ret__ = x
