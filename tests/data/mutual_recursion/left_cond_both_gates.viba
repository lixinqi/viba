import branch
import right_cond_both_gates as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (right.g_false << $env environ)
        << $get_v (builtin.echo << $x 7))
    | (
        branch.never_or_echo
        << $env environ << $cond (right.g_false << $env environ)
        << $get_v (builtin.echo << $x 0))
__ret__ = x
