__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch
import right_part_in_a_branch_dropped as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (false)
        << $get_v (right.f << $a 1))
    | (
        branch.never_or_echo
        << $env args.env << $cond (false)
        << $get_v (builtin.echo << $x 0))
__ret__ = x
