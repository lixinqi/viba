import branch
import right_cond_reads_back_false_side as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (false)
        << $get_v (builtin.echo << $x 7))
    | (
        branch.never_or_echo
        << $env environ << $cond (false)
        << $get_v (right.g << $env environ))
__ret__ = x
