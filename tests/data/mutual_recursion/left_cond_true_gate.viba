__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch
import right_cond_true_gate as right

x =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (right.g << $env args.env)
        << $get_v (builtin.echo << $x 7))
    | (
        branch.never_or_echo
        << $env args.env << $cond (right.g << $env args.env)
        << $get_v (builtin.echo << $x 0))
__ret__ = x
