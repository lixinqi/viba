__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import program as program
import empty as empty
import bad as bad
All = program << $env args.env << 3 << 4
ByTag = program << $env args.env << $b 4 << $a 3
Half = program << $env args.env << $a 3
NoArgs = empty << $env args.env
Bad = bad << $env args.env
