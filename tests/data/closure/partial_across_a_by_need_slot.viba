import branch

ge =
    bool
  <- $env Environment
  <- $x int
  <- $y int
  <- { x >= y }

tick =
    int
  <- $env Environment
  <- { counts as a side effect }

condition = ge << $env environ << $x 1 << $y 0

# 条件先定下来，分支值那一步还没给：这还是一个闭包。
switch = branch.echo_or_never << $cond condition << $get_v (tick << $env environ)
__ret__ = switch << $env environ
