__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

add =
    int
  <- $env Env
  <- $a int
  <- $b int
  <- { add the two }
half = add << $a 40
first = half << $b 1 << (args.env.sub_env << args.env << "one")
__impl__ = add
  << (args.env.sub_env << args.env << "two")
  << $a first
  << $b (half << $b 2 << (args.env.sub_env << args.env << "three"))
