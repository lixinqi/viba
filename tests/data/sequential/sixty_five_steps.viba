# sixty_five_steps —— 65 步：计数文件到 64 步为止，这一步数没有文件接
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

__impl__ =
    sequential
  << $s0 (add << $x 1 << $y 0)
  << $s1 (add << $x 1 << $y 1)
