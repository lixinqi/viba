# A member of a value that nothing implements: the call keeps the member layer
# and drops the environment it was given.
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

Box = Object * $f (int <- $box Box <- $env Env <- $x int) * $y int

inc =
    int
  <- $box Box
  <- $env Env
  <- $x int
  <- { add one }

box = Object * $f inc * $y 2
__impl__ = $f << box << args.env << 1
