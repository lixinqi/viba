# A member of a value that nothing implements: the call keeps the member layer, the
# member's value is the call it stands for written the way a call travels, and the
# environment it was given is dropped.
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

Box = Object * $f (int <- $box Box <- $env Env <- $x int) * $y int

inc =
    int
  <- $box Box
  <- $env Env
  <- $x int
  <- { add one }

box = Object * $f inc * $y 2
__impl__ = $f << box << args.env << 1
