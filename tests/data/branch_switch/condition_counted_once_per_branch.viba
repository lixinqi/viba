__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import gate as gate
import counters as counters

__impl__ =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond ((gate.gate << $env args.env << $mode true))
        << $get_v (counters.tick)
      )
    | (
        branch.never_or_echo
        << $env args.env << $cond ((gate.gate << $env args.env << $mode true))
        << $get_v (counters.tock)
      )
