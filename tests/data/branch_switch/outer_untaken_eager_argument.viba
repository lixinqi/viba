import branch as branch
import counters as counters

__ret__ =
    Oneof
  | (branch.echo_or_never
      << $env environ << $cond false
      << $get_v (builtin.echo << $x (counters.tock << $env environ)))
  | (branch.never_or_echo
      << $env environ << $cond false
      << $get_v (builtin.echo << $x 42))
