__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import poison as poison

__impl__ =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x 42)
      )
    | (
        branch.never_or_echo
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x (1 << $x 2))
      )
