__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import pick as pick
import kinds as kinds

half = pick.add << $a 40

__impl__ =
    branch.echo_or_never
    << $env args.env << $cond true
    << $get_v (half << $b (kinds.answer_int << $env args.env) << $env args.env)
