__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch as branch
import inner as inner

__ret__ =
    Oneof
  | (branch.echo_or_never << $env args.env << $cond true
      << $get_v (builtin.echo << $x (inner.inner_if << $env args.env << $cond true << $get_v inner.always_nine)))
  | (branch.never_or_echo << $env args.env << $cond true
      << $get_v (builtin.echo << $x (inner.inner_if << $env args.env << $cond true << $get_v inner.always_nine)))
