import branch
import counters as counters

# 条件那一步算一次就够：两个开关读的是同一个值，它只叫一次。
__ret__ =
    Oneof
  | (
      branch.echo_or_never
      << $env environ << $cond (counters.counted_gate << $env environ)
      << $get_v (builtin.echo << $x 1)
    )
  | (
      branch.never_or_echo
      << $env environ << $cond (counters.counted_gate << $env environ)
      << $get_v (builtin.echo << $x 0)
    )
