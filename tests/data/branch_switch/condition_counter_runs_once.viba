__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch
import counters as counters

# 条件那一步算一次就够：两个开关取的是同一个值，它只叫一次。
__impl__ =
    Oneof
  | (
      branch.echo_or_never
      << $env args.env << $cond (counters.counted_gate << $env args.env)
      << $get_v (builtin.echo << $x 1)
    )
  | (
      branch.never_or_echo
      << $env args.env << $cond (counters.counted_gate << $env args.env)
      << $get_v (builtin.echo << $x 0)
    )
