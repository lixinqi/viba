import branch as branch
import gate as gate
import inner as inner

__ret__ =
    Oneof
    | (
        inner.inner_if
        << $env environ << $cond ((gate.gate << $env environ << $mode true))
        << $get_v (inner.always_nine)
      )
    | (
        inner.inner_if_not
        << $env environ << $cond ((gate.gate << $env environ << $mode true))
        << $get_v (builtin.echo << $x 0)
      )