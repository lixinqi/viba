import branch as branch

__ret__ =
    Oneof
  | (branch.echo_or_never << $env environ << $cond false << $get_v (builtin.echo << $x 1))
  | (branch.echo_or_never << $env environ << $cond false << $get_v (builtin.echo << $x 2))
  | (branch.echo_or_never << $env environ << $cond false << $get_v (builtin.echo << $x 3))
