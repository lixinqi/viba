__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch

__impl__ =
    Oneof
  | (branch.echo_or_never << $env args.env << $cond false << $get_v (builtin.echo << $x 1))
  | (branch.echo_or_never << $env args.env << $cond false << $get_v (builtin.echo << $x 2))
  | (branch.echo_or_never << $env args.env << $cond false << $get_v (builtin.echo << $x 3))
