__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch as branch
import pick as pick
import counters as counters

half = pick.add << $a 1

__ret__ =
    branch.echo_or_never
    << $env args.env << $cond true
    << $get_v (half << $b (counters.tick << $env args.env) << $env args.env)
