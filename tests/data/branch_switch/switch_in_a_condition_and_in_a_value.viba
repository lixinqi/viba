import branch as branch
import gate as gate
import inner as inner

__ret__ =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (gate.boolean_switch << $env environ << $cond true << $get_v (gate.true_gate << $env environ))
        << $get_v (inner.inner_if << $env environ << $cond true << $get_v inner.always_nine)
      )
    | (
        branch.never_or_echo
        << $env environ << $cond (gate.boolean_switch << $env environ << $cond true << $get_v (gate.true_gate << $env environ))
        << $get_v (builtin.echo << $x 0)
      )