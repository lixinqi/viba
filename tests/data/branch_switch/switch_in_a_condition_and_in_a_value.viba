__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import gate as gate
import inner as inner

__impl__ =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (gate.boolean_switch << $env args.env << $cond true << $get_v (gate.true_gate << $env args.env))
        << $get_v (inner.inner_if << $env args.env << $cond true << $get_v inner.always_nine)
      )
    | (
        branch.never_or_echo
        << $env args.env << $cond (gate.boolean_switch << $env args.env << $cond true << $get_v (gate.true_gate << $env args.env))
        << $get_v (builtin.echo << $x 0)
      )
