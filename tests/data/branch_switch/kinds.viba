# One answer of each value kind, in a file of its own.
answer_int =
    int <- $env Env <- { 7 }
answer_zero =
    int <- $env Env <- { 0 }
answer_text =
    str <- $env Env <- { "kept" }
answer_empty =
    str <- $env Env <- { "" }
answer_flag =
    bool <- $env Env <- { false }
answer_true =
    bool <- $env Env <- { true }
answer_nothing =
    Any <- $env Env <- { nil }
answer_number =
    float <- $env Env <- { 0.5 }
answer_negative =
    float <- $env Env <- { -1.5 }
answer_product =
    (int * str) <- $env Env <- { 1 * "one" }
answer_never =
    never <- $env Env <- { never }
answer_sum =
    (int | str) <- $env Env <- { 3 | "three" }
