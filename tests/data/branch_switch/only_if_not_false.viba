__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import workshop as workshop
import kinds as kinds

__impl__ =
    Oneof
  | (workshop.only_if_not << $env args.env << $cond (false) << $get_v (kinds.answer_int))
  | (workshop.only_if << $env args.env << $cond (false) << $get_v (builtin.echo << $x 7))
