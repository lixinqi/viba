import branch as branch
import kinds as kinds

__ret__ =
    Oneof
    | (
        branch.echo_or_never
        << $env environ << $cond (true)
        << $get_v (kinds.answer_int)
      )
    | (
        branch.never_or_echo
        << $env environ << $cond (true)
        << $get_v (kinds.answer_text)
      )