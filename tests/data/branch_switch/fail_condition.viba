__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch as branch
import poison as poison

__ret__ =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (poison.explode_condition << $env args.env)
        << $get_v (builtin.echo << $x 42)
      )
    | (
        branch.never_or_echo
        << $env args.env << $cond (poison.explode_condition << $env args.env)
        << $get_v (builtin.echo << $x 0)
      )
