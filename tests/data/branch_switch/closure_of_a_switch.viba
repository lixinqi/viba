__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch as branch
import workshop as workshop

when = workshop.only_if << $cond true

__ret__ =
    branch.echo_or_never
    << $env args.env << $cond true
    << $get_v (builtin.echo << $x (when << $env args.env << $get_v (builtin.echo << $x 6)))
