__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch as branch
import inner as inner
import kinds as kinds

__impl__ =
    Oneof
    | (
        branch.echo_or_never
        << $env args.env << $cond (true)
        << $get_v (inner.inner_if << $env args.env << $cond true << $get_v (kinds.answer_int << $env args.env))
      )
    | (
        branch.never_or_echo
        << $env args.env << $cond (true)
        << $get_v (builtin.echo << $x 0)
      )
