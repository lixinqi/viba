import branch
import pick as pick

# 两个半成品各自补完，再把两个答案加在一起。
left = pick.add << $a 1
right = pick.add << $a 2
__ret__ =
    branch.echo_or_never
    << $env environ << $cond true
    << $get_v (pick.add
        << $env environ
        << $a (left << $b 3 << $env environ)
        << $b (right << $b 4 << $env environ))
