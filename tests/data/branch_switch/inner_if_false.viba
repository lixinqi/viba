__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch as branch
import inner as inner

__ret__ =
    Oneof
    | (
        inner.inner_if
        << $env args.env << $cond (false)
        << $get_v (inner.always_nine)
      )
    | (
        inner.inner_if_not
        << $env args.env << $cond (false)
        << $get_v (builtin.echo << $x 0)
      )
