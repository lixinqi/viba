__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

add =
	int
	<- $env Env
	<- $a int
	<- $b int
	<- { add two integer }
import lib as one
import lib as two
__impl__ = add << $env args.env << $a (one << (args.env.sub_env << args.env << "one")) << $b (two << (args.env.sub_env << args.env << "two"))
