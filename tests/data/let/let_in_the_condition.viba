import branch
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
condition = (c := ge << $env environ << $x 1 << $y 0  c)
__ret__ =
    Oneof
  | (branch.id_or_never << $env environ << $condition condition << $v 7)
  | (branch.never_or_id << $env environ << $condition condition << $v 8)
