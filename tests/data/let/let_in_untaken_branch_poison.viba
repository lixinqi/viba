import branch
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
ghost =
    int <- $env Environment <- { nothing implements this }
condition = ge << $env environ << $x 1 << $y 0
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition condition
      << $v (42)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition condition
      << $v (a := (ghost << $env environ)  a)
    )
