import branch
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
tick =
    int <- $env Environment <- { counts as a side effect }
condition = ge << $env environ << $x 1 << $y 0
__ret__ =
    Oneof
  | (branch.id_or_never << $env environ << $condition condition << $v (42))
  | (branch.never_or_id << $env environ << $condition condition << $v (a := (tick << $env environ)  a))
