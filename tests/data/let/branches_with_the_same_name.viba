import branch
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
condition = ge << $env environ << $x 1 << $y 0
__ret__ =
    Oneof
  | (branch.id_or_never << $env environ << $condition condition << $v (a := 1  a))
  | (branch.never_or_id << $env environ << $condition condition << $v (a := 2  a))
