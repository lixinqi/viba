# The main file of the VIBA_PATH case: the module it imports does not sit
# next to it, so `interpret` has to be told where to look.
#
# Judgments (tests/test_interpreter_imports.py):
#   interpret(main.viba, args.env, viba_path=<elsewhere>)  => Ok(7)

__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import pkg.inner

__impl__ = pkg.inner << (args.env.sub_env << args.env << "inner")
