__def__ =
    int
  <- $env Env
  <- $a int
  <- $b int

args = __get_args__ << __def__

add =
    int
  <- $env Env
  <- $a int
  <- $b int
  <- { add the two }

mul =
    int
  <- $env Env
  <- $a int
  <- $b int
  <- { multiply the two }

__ret__ = add
  << args.env
  << (mul << args.env << args.a << args.a)
  << (mul << args.env << args.b << args.b)
