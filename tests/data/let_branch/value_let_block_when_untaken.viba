import branch
tick =
    int <- $env Environment <- { counts as a side effect }
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition false
      << $v (a := (tick << $env environ)  a)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition false
      << $v (42)
    )
