import branch
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition (c := ge << $env environ << $x 2 << $y 1  c)
      << $v (10)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition (c := ge << $env environ << $x 2 << $y 1  c)
      << $v (20)
    )
