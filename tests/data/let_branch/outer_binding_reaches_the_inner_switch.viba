import branch
A = (
  bonus := 7
  outer := (
    Oneof
    | (
        branch.id_or_never
        << $env environ
        << $condition true
        << $v (
          inner := (
            Oneof
            | (
                branch.id_or_never
                << $env environ
                << $condition true
                << $v (bonus)
              )
            | (
                branch.never_or_id
                << $env environ
                << $condition true
                << $v (0)
              )
          )
          inner
        )
      )
    | (
        branch.never_or_id
        << $env environ
        << $condition true
        << $v (0)
      )
  )
  outer
)
__ret__ = A
