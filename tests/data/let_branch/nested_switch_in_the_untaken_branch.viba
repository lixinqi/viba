import branch
tick =
    int <- $env Environment <- { counts as a side effect }
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition true
      << $v (42)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition true
      << $v (
        inner := (
          Oneof
          | (
              branch.id_or_never
              << $env environ
              << $condition true
              << $v (a := (tick << $env environ)  a)
            )
          | (
              branch.never_or_id
              << $env environ
              << $condition true
              << $v (0)
            )
        )
        inner
      )
    )
