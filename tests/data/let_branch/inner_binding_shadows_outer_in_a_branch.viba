import branch
add =
    int <- $env Environment <- $a int <- $b int <- { add the two }
A = (
  a := 1
  r := (
    Oneof
    | (
        branch.id_or_never
        << $env environ
        << $condition true
        << $v (a := 2  a)
      )
    | (
        branch.never_or_id
        << $env environ
        << $condition true
        << $v (0)
      )
  )
  add << $env environ << $a r << $b a
)
__ret__ = A
