import branch
import answer as answer
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition true
      << $v (got := answer << (environ.tmp_sub_env << environ) << ()  got)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition true
      << $v (0)
    )
