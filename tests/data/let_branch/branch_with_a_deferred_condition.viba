import branch
ghost =
    bool <- $env Environment <- { nothing implements this }
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition (ghost << $env environ)
      << $v (10)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition (ghost << $env environ)
      << $v (20)
    )
