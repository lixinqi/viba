import branch
ghost =
    int <- $env Environment <- { nothing implements this }
__ret__ =
    Oneof
  | (
      branch.id_or_never
      << $env environ
      << $condition true
      << $v (42)
    )
  | (
      branch.never_or_id
      << $env environ
      << $condition true
      << $v (a := (ghost << $env environ)  a)
    )
