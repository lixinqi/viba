# Poison in the branch that is not taken.
#
# The condition holds, so the outer `echo_or_never` takes the first branch and
# `never_or_echo` takes the second — the one carrying the poison. The run must
# answer the first branch's value (42); counting it would stop the run at a step
# with no implementation.

__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch

ge =
    bool <- $env Env <- $x int <- $y int <- { x >= y }
poison_not_implemented =
    int <- $env Env <- { nothing implements this }

healthy = 42
condition = ge << $env args.env << $x 1 << $y 0

inner =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond condition << $get_v (builtin.echo << $x healthy))
  | (branch.never_or_echo << $env args.env << $cond condition << $get_v (poison_not_implemented << $env args.env))
__impl__ =
    Oneof
  | (branch.echo_or_never << $env args.env << $cond condition << $get_v (builtin.echo << $x healthy))
  | (branch.never_or_echo << $env args.env << $cond condition << $get_v (builtin.echo << $x inner))
