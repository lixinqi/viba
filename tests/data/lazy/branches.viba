import branch

tick =
    int <- $env Environment <- { the branch that is taken first }
tock =
    int <- $env Environment <- { the branch that is taken second }
ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
threshold_of =
    int <- $env Environment <- { the threshold the host hands over }

# 门槛由宿主给：同一个文件跑不同的门槛，走的是不同的那一支。
condition = ge << $env environ << $x 1 << $y (threshold_of << $env environ)
__ret__ =
  Oneof
  | (branch.echo_or_never << $env environ << $cond condition << $get_v tick)
  | (branch.never_or_echo << $env environ << $cond condition << $get_v tock)
