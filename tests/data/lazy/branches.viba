__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch

tick =
    int <- $env Env <- { the branch that is taken first }
tock =
    int <- $env Env <- { the branch that is taken second }
ge =
    bool <- $env Env <- $x int <- $y int <- { x >= y }
threshold_of =
    int <- $env Env <- { the threshold the host hands over }

# 门槛由宿主给：同一个文件跑不同的门槛，走的是不同的那一支。
condition = ge << $env args.env << $x 1 << $y (threshold_of << $env args.env)
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond condition << $get_v tick)
  | (branch.never_or_echo << $env args.env << $cond condition << $get_v tock)
