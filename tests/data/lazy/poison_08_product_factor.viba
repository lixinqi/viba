# Poison in the branch that is not taken.
#
# The condition holds, so `echo_or_never` takes the first branch and
# `never_or_echo` takes the second — the one carrying the poison. The run must
# answer the first branch's value (42); counting it would defer.

__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch

ge =
    bool <- $env Env <- $x int <- $y int <- { x >= y }
poison_no_implementation =
    int <- $env Env <- { nothing implements this }

healthy = 42
condition = ge << $env args.env << $x 1 << $y 0
__impl__ =
    Oneof
  | (branch.echo_or_never << $env args.env << $cond condition << $get_v (builtin.echo << $x healthy))
  | (branch.never_or_echo
      << $env args.env << $cond condition
      << $get_v (builtin.echo << $x ((poison_no_implementation << $env args.env) * 1)))
