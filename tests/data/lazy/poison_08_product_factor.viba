# Poison in the branch that is not taken.
#
# The condition holds, so `echo_or_never` takes the first branch and
# `never_or_echo` takes the second — the one carrying the poison. The run must
# answer the first branch's value (42); counting it would defer.

import branch

ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
poison_no_implementation =
    int <- $env Environment <- { nothing implements this }

healthy = 42
condition = ge << $env environ << $x 1 << $y 0
__ret__ =
    Oneof
  | (branch.echo_or_never << $env environ << $cond condition << $get_v (builtin.echo << $x healthy))
  | (branch.never_or_echo
      << $env environ << $cond condition
      << $get_v (builtin.echo << $x ((poison_no_implementation << $env environ) * 1)))
