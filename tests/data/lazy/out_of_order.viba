positional =
    int
  <- $env Environment
  <- $cond (bool <- $env Environment)
  <- $get_v (int <- $env Environment)
  <- { the value when the condition holds }

tick =
    int <- $env Environment <- { one }
condition_holds =
    bool <- $env Environment <- { the condition holds }

__ret__ = positional << $env environ << $get_v tick << $cond condition_holds
