import branch

ge =
    bool <- $env Environment <- $x int <- $y int <- { x >= y }
threshold_of =
    int <- $env Environment <- { the threshold the host hands over }
inner_lambda_record =
    int <- $env Environment <- $label str <- { record which branch was taken }
poison_no_implementation =
    int <- $env Environment <- { nothing implements this }

condition = ge << $env environ << $x 1 << $y (threshold_of << $env environ)
__ret__ =
    Oneof
  | (branch.echo_or_never << environ << condition << (poison_no_implementation << environ))
  | (branch.never_or_echo << environ << condition << (inner_lambda_record << environ << "false_branch"))
