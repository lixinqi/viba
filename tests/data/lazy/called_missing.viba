__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

take_x =
    int
  <- $env Env
  <- $get_x (int <- $env Env)
  <- { answer whatever x is }

poison_not_implemented =
    int <- $env Env <- { nothing implements this }

__impl__ = take_x << $env args.env << $get_x (poison_not_implemented << $env args.env)
