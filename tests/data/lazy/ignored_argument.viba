__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

ignore_x =
    int
  <- $env Env
  <- $get_x (int <- $env Env)
  <- { answer seven without looking at x }

poison_no_implementation =
    int <- $env Env <- { nothing implements this }

__impl__ = ignore_x << $env args.env << $get_x (poison_no_implementation << $env args.env)
