__def__ =
    Any
  <- $env Env

args = __get_args__ << __def__

import branch

ge =
    bool <- $env Env <- $x int <- $y int <- { x >= y }
threshold_of =
    int <- $env Env <- { the threshold the host hands over }
inner_lambda_record =
    int <- $env Env <- $label str <- { record which branch was taken }

condition = ge << $env args.env << $x 1 << $y (threshold_of << $env args.env)
__ret__ =
    Oneof
  | (branch.echo_or_never << args.env << condition << (inner_lambda_record << args.env << "true_branch"))
  | (branch.never_or_echo << args.env << condition << (inner_lambda_record << args.env << "false_branch"))
