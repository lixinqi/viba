# A definition written in a module, declaring the environment itself as its
# result: refused like a module's own __decl__ is (only a builtin function may
# answer an environment).
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

env_of =
    Env
  <- $env Env
  <- { hand the environment back }

__impl__ = env_of << $env args.env
