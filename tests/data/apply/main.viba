# 收到一个函数与它那一份实参积：`apply << f << args` 先把它们收下，环境最后给 ——
# `apply` 返回的那次调用还欠着它，环境就缀在那里。实参个数不用写出来，
# apply_impl 的决定在那份积上做。
__decl__ =
    int
  <- $env Env
  <- $f (int <- $env Env <- $a int <- $b int)
  <- $args ($a int * $b int)

args = __get_args__ << __decl__

import apply

__impl__ = apply << args.f << args.args << args.env
