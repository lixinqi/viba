# `apply` 自己当函数再套一层：外面那份积里的成员就是里面那次调用要的两件
# （`$f`、`$args` 正是 `apply` 的两个参数，决断的 `pattern tagged[...]` 按 tag 取它们）。
__decl__ = int <- $env Env

args = __get_args__ << __decl__

add =
    int
  <- $env Env
  <- $a int
  <- $b int
  <- { add two }

import apply

__impl__ = apply << apply << ($f add * $args ($a 1 * $b 2)) << args.env
