# 同一个 `apply`，环境给在第一位：给在哪一位都一样 —— 环境不占实参位，它只跑这次
# 调用，再缀在这次调用答出来的那次调用末尾。实参个数不用写出来，apply_impl 的决定
# 在那份积上做。
__decl__ =
    int
  <- $env Env
  <- $f (int <- $env Env <- $a int <- $b int)
  <- $args ($a int * $b int)

args = __get_args__ << __decl__

import apply

__impl__ = apply << args.env << args.f << args.args
