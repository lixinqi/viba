__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

watch =
    int
  <- $env Env
  <- $x (int <- $env Env)
  <- { hand x back }
ignore =
    int
  <- $env Env
  <- $x (int <- $env Env)
  <- { answer seven without looking at x }
__impl__ = ignore << $env args.env << $x (builtin.echo << $x "x")
