LoopCount := int
MaxLines := int
TimeBudget := float
HasTests := bool
Scores := dict[str, int]

Rule04 :=
  Object
  * $loop_count Metric[LoopCount]
  * $max_lines Metric[MaxLines]
  * $time_budget Metric[TimeBudget]
  * $has_tests Metric[HasTests]
  * $scores Metric[Scores]
  * $assert_00_loop_count_at_most_24
      Assert[{loop_count at most 24}, $python_code {
def handler(self):
    return self.loop_count.value <= 24
}]
  * $assert_01_loop_count_under_100
      Assert[{loop_count under 100}, $python_code {
def handler(self):
    return self.loop_count.value < 100
}]
  * $assert_02_max_lines_at_most_24
      Assert[{max_lines at most 24}, $python_code {
def handler(self):
    return self.max_lines.value <= 24
}]
  * $assert_03_max_lines_under_100
      Assert[{max_lines under 100}, $python_code {
def handler(self):
    return self.max_lines.value < 100
}]
  * $assert_04_loop_count_not_above_max_lines
      Assert[{loop_count not above max_lines}, $python_code {
def handler(self):
    return self.loop_count.value <= self.max_lines.value
}]
  * $assert_05_time_budget_within_50_5
      Assert[{time_budget within 50.5}, $python_code {
def handler(self):
    return self.time_budget.value <= 50.5
}]
  * $assert_06_time_budget_non_negative
      Assert[{time_budget non-negative}, $python_code {
def handler(self):
    return self.time_budget.value >= 0.0
}]
  * $assert_07_has_tests_required
      Assert[{has_tests required}, $python_code {
def handler(self):
    return self.has_tests.value
}]
  * $assert_08_has_tests_forbidden
      Assert[{has_tests forbidden}, $python_code {
def handler(self):
    return not self.has_tests.value
}]
  * $assert_09_scores_non_empty
      Assert[{scores non-empty}, $python_code {
def handler(self):
    return len(self.scores.value) >= 1
}]
