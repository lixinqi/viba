# gt_str —— "b" 排在 "a" 后得 true，"a" 排在 "b" 后得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (gt_str << $env args.env << $x "b" << $y "a")
backward = bool_to_str << $env args.env << $x (gt_str << $env args.env << $x "a" << $y "b")

__impl__ = concat << $env args.env << $x forward << $y backward
