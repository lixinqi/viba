# not —— true 取反得 false，false 取反得 true
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (not << $env args.env << $x true)
backward = bool_to_str << $env args.env << $x (not << $env args.env << $x false)

__impl__ = concat << $env args.env << $x forward << $y backward
