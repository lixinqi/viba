# eq —— 3 等于 3 得 true，3 等于 4 得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (eq << $env args.env << $x 3 << $y 3)
backward = bool_to_str << $env args.env << $x (eq << $env args.env << $x 3 << $y 4)

__impl__ = concat << $env args.env << $x forward << $y backward
