# eq_str —— "a" 与 "a" 相同答 true，"a" 与 "b" 相同答 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (eq_str << $env args.env << $x "a" << $y "a")
backward = bool_to_str << $env args.env << $x (eq_str << $env args.env << $x "a" << $y "b")

__impl__ = concat << $env args.env << $x forward << $y backward
