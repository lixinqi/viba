# eq_bool —— true 与 true 相同得 true，true 与 false 相同得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (eq_bool << $env args.env << $x true << $y true)
backward = bool_to_str << $env args.env << $x (eq_bool << $env args.env << $x true << $y false)

__impl__ = concat << $env args.env << $x forward << $y backward
