# ne_bool —— true 与 false 不同答 true，true 与 true 不同答 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (ne_bool << $env args.env << $x true << $y false)
backward = bool_to_str << $env args.env << $x (ne_bool << $env args.env << $x true << $y true)

__impl__ = concat << $env args.env << $x forward << $y backward
