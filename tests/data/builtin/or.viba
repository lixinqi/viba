# or —— false 与 false 答 false，true 与 false 答 true，true 与 true 答 true
__decl__ = str <- $env Env

args = __get_args__ << __decl__

first = bool_to_str << $env args.env << $x (or << $env args.env << $x false << $y false)
second = bool_to_str << $env args.env << $x (or << $env args.env << $x true << $y false)
third = bool_to_str << $env args.env << $x (or << $env args.env << $x true << $y true)

__impl__ =
    concat << $env args.env
  << $x first
  << $y (concat << $env args.env << $x second << $y third)
