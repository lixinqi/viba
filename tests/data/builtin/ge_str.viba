# ge_str —— "a" 排在 "a" 后或相同答 true，"a" 排在 "b" 后或相同答 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (ge_str << $env args.env << $x "a" << $y "a")
backward = bool_to_str << $env args.env << $x (ge_str << $env args.env << $x "a" << $y "b")

__impl__ = concat << $env args.env << $x forward << $y backward
