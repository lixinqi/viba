# lt —— 1 小于 2 得 true，2 小于 1 得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (lt << $env args.env << $x 1 << $y 2)
backward = bool_to_str << $env args.env << $x (lt << $env args.env << $x 2 << $y 1)

__impl__ = concat << $env args.env << $x forward << $y backward
