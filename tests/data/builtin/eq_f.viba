# eq_f —— 1.0 等于 1.0 答 true，1.0 等于 2.0 答 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (eq_f << $env args.env << $x 1.0 << $y 1.0)
backward = bool_to_str << $env args.env << $x (eq_f << $env args.env << $x 1.0 << $y 2.0)

__impl__ = concat << $env args.env << $x forward << $y backward
