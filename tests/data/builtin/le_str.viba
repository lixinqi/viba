# le_str —— "a" 排在 "a" 前或相同得 true，"b" 排在 "a" 前或相同得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (le_str << $env args.env << $x "a" << $y "a")
backward = bool_to_str << $env args.env << $x (le_str << $env args.env << $x "b" << $y "a")

__impl__ = concat << $env args.env << $x forward << $y backward
