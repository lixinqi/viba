# ne_str —— "a" 与 "b" 不同得 true，"a" 与 "a" 不同得 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (ne_str << $env args.env << $x "a" << $y "b")
backward = bool_to_str << $env args.env << $x (ne_str << $env args.env << $x "a" << $y "a")

__impl__ = concat << $env args.env << $x forward << $y backward
