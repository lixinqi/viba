# lt_str —— "a" 排在 "b" 前答 true，"b" 排在 "a" 前答 false
__decl__ = str <- $env Env

args = __get_args__ << __decl__

forward = bool_to_str << $env args.env << $x (lt_str << $env args.env << $x "a" << $y "b")
backward = bool_to_str << $env args.env << $x (lt_str << $env args.env << $x "b" << $y "a")

__impl__ = concat << $env args.env << $x forward << $y backward
