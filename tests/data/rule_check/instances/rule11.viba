# rule11.viba 的一个实例：seed=11, fail_prob=0.1
# 判定：Ok(False)
Instance11 :=
    RuleObject
    * $code_length 57
    * $max_lines 71
    * $coverage_ratio 85.69
    * $time_budget 78.12
    * $is_public true
    * $keywords ListLiteral["beta", "beta"]
    * $author_name "delta"
    * $assert_00_code_length_at_most_24 Assert[{code_length at most 24}, $python_code {
def handler(self):
    return self.code_length.value <= 24
}]
    * $assert_01_code_length_under_100 Assert[{code_length under 100}, $python_code {
def handler(self):
    return self.code_length.value < 100
}]
    * $assert_02_max_lines_at_most_24 AssertionFailed[nil, str]
    * $assert_03_max_lines_under_100 Assert[{max_lines under 100}, $python_code {
def handler(self):
    return self.max_lines.value < 100
}]
    * $assert_04_code_length_not_above_max_lines AssertionFailed[nil, str]
    * $assert_05_coverage_ratio_within_50_5 Assert[{coverage_ratio within 50.5}, $python_code {
def handler(self):
    return self.coverage_ratio.value <= 50.5
}]
    * $assert_06_coverage_ratio_non_negative Assert[{coverage_ratio non-negative}, $python_code {
def handler(self):
    return self.coverage_ratio.value >= 0.0
}]
    * $assert_07_time_budget_within_50_5 AssertionFailed[nil, str]
    * $assert_08_time_budget_non_negative Assert[{time_budget non-negative}, $python_code {
def handler(self):
    return self.time_budget.value >= 0.0
}]
    * $assert_09_is_public_required Assert[{is_public required}, $python_code {
def handler(self):
    return self.is_public.value
}]
