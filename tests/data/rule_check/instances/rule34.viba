# rule34.viba 的一个实例：seed=34, fail_prob=0.1
# 判定：Ok(False)
Instance34 :=
    RuleObject
    * $max_lines 67
    * $time_budget 35.71
    * $is_public true
    * $author_name "beta"
    * $int_list ListLiteral
    * $tags SetLiteral["gamma"]
    * $assert_00_max_lines_at_most_24 Assert[{max_lines at most 24}, $python_code {
def handler(self):
    return self.max_lines.value <= 24
}]
    * $assert_01_max_lines_under_100 AssertionFailed[nil, str]
    * $assert_02_time_budget_within_50_5 Assert[{time_budget within 50.5}, $python_code {
def handler(self):
    return self.time_budget.value <= 50.5
}]
    * $assert_03_time_budget_non_negative Assert[{time_budget non-negative}, $python_code {
def handler(self):
    return self.time_budget.value >= 0.0
}]
    * $assert_04_is_public_required Assert[{is_public required}, $python_code {
def handler(self):
    return self.is_public.value
}]
    * $assert_05_is_public_forbidden Assert[{is_public forbidden}, $python_code {
def handler(self):
    return not self.is_public.value
}]
    * $assert_06_author_name_short AssertionFailed[nil, str]
    * $assert_07_author_name_not_empty Assert[{author_name not empty}, $python_code {
def handler(self):
    return len(self.author_name.value) >= 1
}]
    * $assert_08_tags_bounded AssertionFailed[nil, str]
    * $assert_09_tags_non_empty Assert[{tags non-empty}, $python_code {
def handler(self):
    return len(self.tags.value) >= 1
}]
