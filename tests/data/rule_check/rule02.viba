MaxLines := int
ParamCount := int
CoverageRatio := float
IsPublic := bool
Imports := list[str]

Rule02 :=
  RuleObject
  * $max_lines Metric[MaxLines]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $is_public Metric[IsPublic]
  * $imports Metric[Imports]
  * $assert_00_max_lines_at_most_24
      Assert[{max_lines at most 24}, $python_code {
def handler(self):
    return self.max_lines.value <= 24
}]
  * $assert_01_max_lines_under_100
      Assert[{max_lines under 100}, $python_code {
def handler(self):
    return self.max_lines.value < 100
}]
  * $assert_02_param_count_at_most_24
      Assert[{param_count at most 24}, $python_code {
def handler(self):
    return self.param_count.value <= 24
}]
  * $assert_03_param_count_under_100
      Assert[{param_count under 100}, $python_code {
def handler(self):
    return self.param_count.value < 100
}]
  * $assert_04_max_lines_not_above_param_count
      Assert[{max_lines not above param_count}, $python_code {
def handler(self):
    return self.max_lines.value <= self.param_count.value
}]
  * $assert_05_coverage_ratio_within_50_5
      Assert[{coverage_ratio within 50.5}, $python_code {
def handler(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_06_coverage_ratio_non_negative
      Assert[{coverage_ratio non-negative}, $python_code {
def handler(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_07_is_public_required
      Assert[{is_public required}, $python_code {
def handler(self):
    return self.is_public.value
}]
  * $assert_08_is_public_forbidden
      Assert[{is_public forbidden}, $python_code {
def handler(self):
    return not self.is_public.value
}]
  * $assert_09_imports_non_empty
      Assert[{imports non-empty}, $python_code {
def handler(self):
    return len(self.imports.value) >= 1
}]
