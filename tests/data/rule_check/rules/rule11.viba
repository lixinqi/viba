CodeLength := int
MaxLines := int
CoverageRatio := float
TimeBudget := float
IsPublic := bool
Keywords := list[str]
AuthorName := str

Rule11 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $coverage_ratio Metric[CoverageRatio]
  * $time_budget Metric[TimeBudget]
  * $is_public Metric[IsPublic]
  * $keywords Metric[Keywords]
  * $author_name Metric[AuthorName]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.code_length.value <= 24
}]
  * $assert_01_code_length_under_100
      Predicate[{code_length under 100}, $python_code {
def predicate(self):
    return self.code_length.value < 100
}]
  * $assert_02_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.max_lines.value <= 24
}]
  * $assert_03_max_lines_under_100
      Predicate[{max_lines under 100}, $python_code {
def predicate(self):
    return self.max_lines.value < 100
}]
  * $assert_04_code_length_not_above_max_lines
      Predicate[{code_length not above max_lines}, $python_code {
def predicate(self):
    return self.code_length.value <= self.max_lines.value
}]
  * $assert_05_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_06_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_07_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.time_budget.value <= 50.5
}]
  * $assert_08_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.time_budget.value >= 0.0
}]
  * $assert_09_is_public_required
      Predicate[{is_public required}, $python_code {
def predicate(self):
    return self.is_public.value
}]
