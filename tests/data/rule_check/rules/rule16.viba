CyclomaticComplexity := int
IndentWidth := $spaces int
BudgetSplit := $spent float * $cap float
CoverageRatio := float
IsPublic := bool
AuthorName := str
Keywords := list[str]
Tags := set[str]

Rule16 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $indent_width Metric[IndentWidth]
  * $budget_split Metric[BudgetSplit]
  * $coverage_ratio Metric[CoverageRatio]
  * $is_public Metric[IsPublic]
  * $author_name Metric[AuthorName]
  * $keywords Metric[Keywords]
  * $tags Metric[Tags]
  * $assert_00_cyclomatic_complexity_at_most_24
      Assert[{cyclomatic_complexity at most 24}, $python_code {
def handler(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_01_cyclomatic_complexity_under_100
      Assert[{cyclomatic_complexity under 100}, $python_code {
def handler(self):
    return self.cyclomatic_complexity.value < 100
}]
  * $assert_02_coverage_ratio_within_50_5
      Assert[{coverage_ratio within 50.5}, $python_code {
def handler(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_03_coverage_ratio_non_negative
      Assert[{coverage_ratio non-negative}, $python_code {
def handler(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_04_is_public_required
      Assert[{is_public required}, $python_code {
def handler(self):
    return self.is_public.value
}]
  * $assert_05_is_public_forbidden
      Assert[{is_public forbidden}, $python_code {
def handler(self):
    return not self.is_public.value
}]
  * $assert_06_author_name_short
      Assert[{author_name short}, $python_code {
def handler(self):
    return len(self.author_name.value) <= 8
}]
  * $assert_07_author_name_not_empty
      Assert[{author_name not empty}, $python_code {
def handler(self):
    return len(self.author_name.value) >= 1
}]
  * $assert_08_keywords_non_empty
      Assert[{keywords non-empty}, $python_code {
def handler(self):
    return len(self.keywords.value) >= 1
}]
  * $assert_09_keywords_bounded
      Assert[{keywords bounded}, $python_code {
def handler(self):
    return len(self.keywords.value) <= 4
}]
