CyclomaticComplexity := int
ParamCount := int
CoverageRatio := float
AuthorName := str
Keywords := list[str]

Rule05 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $author_name Metric[AuthorName]
  * $keywords Metric[Keywords]
  * $assert_00_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_01_cyclomatic_complexity_under_100
      Predicate[{cyclomatic_complexity under 100}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value < 100
}]
  * $assert_02_param_count_at_most_24
      Predicate[{param_count at most 24}, $python_code {
def predicate(self):
    return self.param_count.value <= 24
}]
  * $assert_03_param_count_under_100
      Predicate[{param_count under 100}, $python_code {
def predicate(self):
    return self.param_count.value < 100
}]
  * $assert_04_cyclomatic_complexity_not_above_param_count
      Predicate[{cyclomatic_complexity not above param_count}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= self.param_count.value
}]
  * $assert_05_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_06_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_07_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.author_name.value) <= 8
}]
  * $assert_08_author_name_not_empty
      Predicate[{author_name not empty}, $python_code {
def predicate(self):
    return len(self.author_name.value) >= 1
}]
  * $assert_09_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.keywords.value) >= 1
}]
