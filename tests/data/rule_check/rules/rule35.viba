CyclomaticComplexity := int
ParamCount := int
CoverageRatio := float
ModuleName := str
Imports := list[str]
Lookup := dict[str, str]
IndentWidth := $spaces int

Rule35 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $module_name Metric[ModuleName]
  * $imports Metric[Imports]
  * $lookup Metric[Lookup]
  * $indent_width Metric[IndentWidth]
  * $assert_00_cyclomatic_complexity_at_most_24
      Assert[{cyclomatic_complexity at most 24}, $python_code {
def handler(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_01_cyclomatic_complexity_under_100
      Assert[{cyclomatic_complexity under 100}, $python_code {
def handler(self):
    return self.cyclomatic_complexity.value < 100
}]
  * $assert_02_param_count_at_most_24
      Assert[{param_count at most 24}, $python_code {
def handler(self):
    return self.param_count.value <= 24
}]
  * $assert_03_param_count_under_100
      Assert[{param_count under 100}, $python_code {
def handler(self):
    return self.param_count.value < 100
}]
  * $assert_04_cyclomatic_complexity_not_above_param_count
      Assert[{cyclomatic_complexity not above param_count}, $python_code {
def handler(self):
    return self.cyclomatic_complexity.value <= self.param_count.value
}]
  * $assert_05_coverage_ratio_within_50_5
      Assert[{coverage_ratio within 50.5}, $python_code {
def handler(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_06_coverage_ratio_non_negative
      Assert[{coverage_ratio non-negative}, $python_code {
def handler(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_07_module_name_short
      Assert[{module_name short}, $python_code {
def handler(self):
    return len(self.module_name.value) <= 8
}]
  * $assert_08_module_name_not_empty
      Assert[{module_name not empty}, $python_code {
def handler(self):
    return len(self.module_name.value) >= 1
}]
  * $assert_09_imports_non_empty
      Assert[{imports non-empty}, $python_code {
def handler(self):
    return len(self.imports.value) >= 1
}]
  * $assert_10_imports_bounded
      Assert[{imports bounded}, $python_code {
def handler(self):
    return len(self.imports.value) <= 4
}]
  * $assert_11_indent_width_non_negative
      Assert[{indent_width non-negative}, $python_code {
def handler(self):
    return self.indent_width.spaces >= 0
}]
