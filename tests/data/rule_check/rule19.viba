CodeLength := int
MaxLines := int
LoopCount := int
ParamCount := int
CoverageRatio := float
TimeBudget := float
HasTests := bool
IsPublic := bool
ModuleName := str
AuthorName := str

Rule19 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $loop_count Metric[LoopCount]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $time_budget Metric[TimeBudget]
  * $has_tests Metric[HasTests]
  * $is_public Metric[IsPublic]
  * $module_name Metric[ModuleName]
  * $author_name Metric[AuthorName]
  * $assert_00_code_length_at_most_24
      Assert[{code_length at most 24}, $python_code {
def handler(self):
    return self.code_length.value <= 24
}]
  * $assert_01_code_length_under_100
      Assert[{code_length under 100}, $python_code {
def handler(self):
    return self.code_length.value < 100
}]
  * $assert_02_max_lines_at_most_24
      Assert[{max_lines at most 24}, $python_code {
def handler(self):
    return self.max_lines.value <= 24
}]
  * $assert_03_max_lines_under_100
      Assert[{max_lines under 100}, $python_code {
def handler(self):
    return self.max_lines.value < 100
}]
  * $assert_04_loop_count_at_most_24
      Assert[{loop_count at most 24}, $python_code {
def handler(self):
    return self.loop_count.value <= 24
}]
  * $assert_05_loop_count_under_100
      Assert[{loop_count under 100}, $python_code {
def handler(self):
    return self.loop_count.value < 100
}]
  * $assert_06_param_count_at_most_24
      Assert[{param_count at most 24}, $python_code {
def handler(self):
    return self.param_count.value <= 24
}]
  * $assert_07_param_count_under_100
      Assert[{param_count under 100}, $python_code {
def handler(self):
    return self.param_count.value < 100
}]
  * $assert_08_code_length_not_above_max_lines
      Assert[{code_length not above max_lines}, $python_code {
def handler(self):
    return self.code_length.value <= self.max_lines.value
}]
  * $assert_09_coverage_ratio_within_50_5
      Assert[{coverage_ratio within 50.5}, $python_code {
def handler(self):
    return self.coverage_ratio.value <= 50.5
}]
