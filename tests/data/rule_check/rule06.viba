CodeLength := int
IndentWidth := $spaces int
DocCoverage := $documented_lines int * $total_lines int
BudgetSplit := $spent float * $cap float
HasTests := bool
Keywords := list[str]
AuthorName := str

Rule06 :=
  Object
  * $code_length Metric[CodeLength]
  * $indent_width Metric[IndentWidth]
  * $doc_coverage Metric[DocCoverage]
  * $budget_split Metric[BudgetSplit]
  * $has_tests Metric[HasTests]
  * $keywords Metric[Keywords]
  * $author_name Metric[AuthorName]
  * $assert_00_code_length_at_most_24
      Assert[{code_length at most 24}, $python_code {
def handler(self):
    return self.code_length.value <= 24
}]
  * $assert_01_code_length_under_100
      Assert[{code_length under 100}, $python_code {
def handler(self):
    return self.code_length.value < 100
}]
  * $assert_02_has_tests_required
      Assert[{has_tests required}, $python_code {
def handler(self):
    return self.has_tests.value
}]
  * $assert_03_has_tests_forbidden
      Assert[{has_tests forbidden}, $python_code {
def handler(self):
    return not self.has_tests.value
}]
  * $assert_04_author_name_short
      Assert[{author_name short}, $python_code {
def handler(self):
    return len(self.author_name.value) <= 8
}]
  * $assert_05_author_name_not_empty
      Assert[{author_name not empty}, $python_code {
def handler(self):
    return len(self.author_name.value) >= 1
}]
  * $assert_06_keywords_non_empty
      Assert[{keywords non-empty}, $python_code {
def handler(self):
    return len(self.keywords.value) >= 1
}]
  * $assert_07_keywords_bounded
      Assert[{keywords bounded}, $python_code {
def handler(self):
    return len(self.keywords.value) <= 4
}]
  * $assert_08_indent_width_non_negative
      Assert[{indent_width non-negative}, $python_code {
def handler(self):
    return self.indent_width.spaces >= 0
}]
  * $assert_09_doc_coverage_documented_within_total
      Assert[{doc_coverage documented within total}, $python_code {
def handler(self):
    return self.doc_coverage.documented_lines <= self.doc_coverage.total_lines
}]
