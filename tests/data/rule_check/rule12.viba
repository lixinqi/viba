LoopCount := int
ParamCount := int
IndentWidth := $spaces int
DocCoverage := $documented_lines int * $total_lines int
HasTests := bool
Scores := dict[str, int]
Tags := set[str]

Rule12 :=
  RuleObject
  * $loop_count Metric[LoopCount]
  * $param_count Metric[ParamCount]
  * $indent_width Metric[IndentWidth]
  * $doc_coverage Metric[DocCoverage]
  * $has_tests Metric[HasTests]
  * $scores Metric[Scores]
  * $tags Metric[Tags]
  * $assert_00_loop_count_at_most_24
      Assert[{loop_count at most 24}, $python_code {
def handler(self):
    return self.loop_count.value <= 24
}]
  * $assert_01_loop_count_under_100
      Assert[{loop_count under 100}, $python_code {
def handler(self):
    return self.loop_count.value < 100
}]
  * $assert_02_param_count_at_most_24
      Assert[{param_count at most 24}, $python_code {
def handler(self):
    return self.param_count.value <= 24
}]
  * $assert_03_param_count_under_100
      Assert[{param_count under 100}, $python_code {
def handler(self):
    return self.param_count.value < 100
}]
  * $assert_04_loop_count_not_above_param_count
      Assert[{loop_count not above param_count}, $python_code {
def handler(self):
    return self.loop_count.value <= self.param_count.value
}]
  * $assert_05_has_tests_required
      Assert[{has_tests required}, $python_code {
def handler(self):
    return self.has_tests.value
}]
  * $assert_06_has_tests_forbidden
      Assert[{has_tests forbidden}, $python_code {
def handler(self):
    return not self.has_tests.value
}]
  * $assert_07_tags_bounded
      Assert[{tags bounded}, $python_code {
def handler(self):
    return len(self.tags.value) <= 3
}]
  * $assert_08_scores_non_empty
      Assert[{scores non-empty}, $python_code {
def handler(self):
    return len(self.scores.value) >= 1
}]
  * $assert_09_indent_width_non_negative
      Assert[{indent_width non-negative}, $python_code {
def handler(self):
    return self.indent_width.spaces >= 0
}]
