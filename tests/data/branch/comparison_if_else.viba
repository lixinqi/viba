__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

import branch

foo =
    int <- $env Env <- { the case's own value }
ge =
    bool <- $env Env <- $x int <- $y int <- { x >= y }
threshold_of =
    int <- $env Env <- { the threshold the host hands over }

a = foo << $env args.env
condition = ge << $env args.env << $x a << $y (threshold_of << $env args.env)
__impl__ =
  Oneof
  | (branch.echo_or_never << $env args.env << $cond condition << $get_v (builtin.echo << $x a))
  | (branch.never_or_echo << $env args.env << $cond condition << $get_v (builtin.echo << $x 0))
