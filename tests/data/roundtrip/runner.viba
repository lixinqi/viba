# A run that only holds a closure and hands it an environment.
#
# The `$call` an `UnderlyingOpErr` carries is a closure — type `Any <- $env Env`,
# its environment not given yet — so running it is giving it an environment; no
# module is given for it. The host implements `hold`: it hands back whatever
# closure it is holding (viba-interpreter.md, the chapter that introduces `__dyn_call__`).
__decl__ =
    Any
  <- $env Env

args = __get_args__ << __decl__

hold =
    Any
  <- $env Env
  <- { the host hands back the closure it holds }

held = hold << $env args.env
__impl__ = held << args.env
