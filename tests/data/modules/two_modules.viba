__def__ =
    int
  <- $env Env

args = __get_args__ << __def__

add =
	int
	<- $env Env
	<- $a int
	<- $b int
	<- { add two integer }
import lib as one
import other as two
__ret__ = add << $env args.env
  << $a (one << (args.env.sub_env << args.env << "m"))
  << $b (two << (args.env.sub_env << args.env << "m"))
