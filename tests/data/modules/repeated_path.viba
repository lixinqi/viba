__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

add =
	int
	<- $env Env
	<- $a int
	<- $b int
	<- { add two integer }
import lib as lib
__impl__ = add << $env args.env
  << $a (lib << (args.env.sub_env << args.env << "one"))
  << $b (lib << (args.env.sub_env << args.env << "one"))
