XLen := int
YLen := int

SmallRule :=
  RuleObject
  * $x Metric[XLen]
  * $assert_x_le_24
      Predicate[{x at most 24}, $python_code {
def predicate(self):
    return self.get_x().get_value().value <= 24
}]

BigRule :=
  RuleObject
  * $y Metric[YLen]
  * $assert_y_ge_10
      Predicate[{y at least 10}, $python_code {
def predicate(self):
    return self.get_y().get_value().value >= 10
}]

SumRule :=
  Oneof
  | $small SmallRule
  | $big BigRule

SumWitnessPass :=
  $small (RuleObject * $x ($value 20) * $assert_x_le_24 Predicate[{x at most 24}, $python_code {
def predicate(self):
    return self.get_x().get_value().value <= 24
}])

SumWitnessFail :=
  $small (RuleObject * $x ($value 30) * $assert_x_le_24 PredicationFailed[nil, str])
