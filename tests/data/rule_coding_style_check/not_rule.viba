# Prohibitive rule: not[A] is never <- $not_operand A. is_sub_type knows the
# exponential, so a compliant witness refutes every branch with a
# same-tag never <- Branch field (the $not_operand tag is the definition's
# label for the operand, not a level in the data). A branch left
# positive, or missing, is no refutation and judges False.

Homicide := Predicate[{homicide prohibited}, $python_code {
def predicate(self):
    return False
}]

Arson := Predicate[{arson prohibited}, $python_code {
def predicate(self):
    return False
}]

Robbery := Predicate[{robbery prohibited}, $python_code {
def predicate(self):
    return False
}]

NoDeathPenaltyRule :=
  RuleObject
  * $not_crimes
      not[
        $homicide Homicide
        | $arson Arson
        | $robbery Robbery
      ]

LawAbidingWitness :=
  Object
  * $not_crimes
      not[
        $homicide PredicationFailed[nil, str]
        | $arson PredicationFailed[nil, str]
        | $robbery PredicationFailed[nil, str]
      ]

ViolatingWitness :=
  Object
  * $not_crimes
      not[
        $homicide Homicide
        | $arson PredicationFailed[nil, str]
        | $robbery PredicationFailed[nil, str]
      ]

PartialWitness :=
  Object
  * $not_crimes
      not[
        $homicide PredicationFailed[nil, str]
        | $arson PredicationFailed[nil, str]
      ]
