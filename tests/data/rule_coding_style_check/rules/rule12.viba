LoopCount := int
ParamCount := int
IndentWidth := $spaces int
DocCoverage := $documented_lines int * $total_lines int
HasTests := bool
Scores := dict[str, int]
Tags := set[str]

Rule12 :=
  RuleObject
  * $loop_count Metric[LoopCount]
  * $param_count Metric[ParamCount]
  * $indent_width Metric[IndentWidth]
  * $doc_coverage Metric[DocCoverage]
  * $has_tests Metric[HasTests]
  * $scores Metric[Scores]
  * $tags Metric[Tags]
  * $assert_00_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.loop_count.value <= 24
}]
  * $assert_01_param_count_at_most_24
      Predicate[{param_count at most 24}, $python_code {
def predicate(self):
    return self.param_count.value <= 24
}]
  * $assert_02_loop_count_not_above_param_count
      Predicate[{loop_count not above param_count}, $python_code {
def predicate(self):
    return self.loop_count.value <= self.param_count.value
}]
  * $assert_03_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.has_tests.value
}]
  * $assert_04_tags_bounded
      Predicate[{tags bounded}, $python_code {
def predicate(self):
    return len(self.tags.value) <= 3
}]
  * $assert_05_tags_non_empty
      Predicate[{tags non-empty}, $python_code {
def predicate(self):
    return len(self.tags.value) >= 1
}]
  * $assert_06_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.scores.value) >= 1
}]
  * $assert_07_scores_bounded
      Predicate[{scores bounded}, $python_code {
def predicate(self):
    return len(self.scores.value) <= 4
}]
  * $assert_08_indent_width_non_negative
      Predicate[{indent_width non-negative}, $python_code {
def predicate(self):
    return self.indent_width.spaces >= 0
}]
  * $assert_09_doc_coverage_documented_within_total
      Predicate[{doc_coverage documented within total}, $python_code {
def predicate(self):
    return self.doc_coverage.documented_lines <= self.doc_coverage.total_lines
}]
