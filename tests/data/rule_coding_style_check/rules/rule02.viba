MaxLines := int
ParamCount := int
CoverageRatio := float
IsPublic := bool
Imports := list[str]

Rule02 :=
  RuleObject
  * $max_lines Metric[MaxLines]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $is_public Metric[IsPublic]
  * $imports Metric[Imports]
  * $assert_00_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= 24
}]
  * $assert_01_param_count_at_most_24
      Predicate[{param_count at most 24}, $python_code {
def predicate(self):
    return self.get_param_count().get_value().value <= 24
}]
  * $assert_02_max_lines_not_above_param_count
      Predicate[{max_lines not above param_count}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= self.get_param_count().get_value().value
}]
  * $assert_03_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_04_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_05_is_public_required
      Predicate[{is_public required}, $python_code {
def predicate(self):
    return self.get_is_public().get_value().value
}]
  * $assert_06_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) >= 1
}]
  * $assert_07_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) <= 4
}]
