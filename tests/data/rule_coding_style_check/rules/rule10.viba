CyclomaticComplexity := int
CoverageRatio := float
ModuleName := str
Imports := list[str]
HasTests := bool
TraceLevel := $quiet () | $verbose ()

Rule10 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $coverage_ratio Metric[CoverageRatio]
  * $module_name Metric[ModuleName]
  * $imports Metric[Imports]
  * $has_tests Metric[HasTests]
  * $trace_level Metric[TraceLevel]
  * $assert_00_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_01_cyclomatic_complexity_under_100
      Predicate[{cyclomatic_complexity under 100}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value < 100
}]
  * $assert_02_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_03_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_04_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.has_tests.value
}]
  * $assert_05_has_tests_forbidden
      Predicate[{has_tests forbidden}, $python_code {
def predicate(self):
    return not self.has_tests.value
}]
  * $assert_06_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.module_name.value) <= 8
}]
  * $assert_07_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.module_name.value) >= 1
}]
  * $assert_08_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.imports.value) >= 1
}]
  * $assert_09_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.imports.value) <= 4
}]
