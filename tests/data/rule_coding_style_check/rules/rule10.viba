CyclomaticComplexity := int
CoverageRatio := float
ModuleName := str
Imports := list[str]
HasTests := bool
TraceLevel := $quiet () | $verbose ()

Rule10 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $coverage_ratio Metric[CoverageRatio]
  * $module_name Metric[ModuleName]
  * $imports Metric[Imports]
  * $has_tests Metric[HasTests]
  * $trace_level Metric[TraceLevel]
  * $assert_00_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.get_cyclomatic_complexity().get_value().value <= 24
}]
  * $assert_01_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_02_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_03_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.get_has_tests().get_value().value
}]
  * $assert_04_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) <= 8
}]
  * $assert_05_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) >= 1
}]
  * $assert_06_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) >= 1
}]
  * $assert_07_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) <= 4
}]
