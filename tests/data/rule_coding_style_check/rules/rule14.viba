MaxLines := int
TimeBudget := float
AuthorName := str
Keywords := list[str]
DocCoverage := $documented_lines int * $total_lines int
Tags := set[str]
TraceLevel := $quiet () | $verbose ()

Rule14 :=
  RuleObject
  * $max_lines Metric[MaxLines]
  * $time_budget Metric[TimeBudget]
  * $author_name Metric[AuthorName]
  * $keywords Metric[Keywords]
  * $doc_coverage Metric[DocCoverage]
  * $tags Metric[Tags]
  * $trace_level Metric[TraceLevel]
  * $assert_00_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= 24
}]
  * $assert_01_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value <= 50.5
}]
  * $assert_02_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value >= 0.0
}]
  * $assert_03_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) <= 8
}]
  * $assert_04_author_name_not_empty
      Predicate[{author_name not empty}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) >= 1
}]
  * $assert_05_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) >= 1
}]
  * $assert_06_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) <= 4
}]
  * $assert_07_tags_bounded
      Predicate[{tags bounded}, $python_code {
def predicate(self):
    return len(self.get_tags().get_value()) <= 3
}]
  * $assert_08_tags_non_empty
      Predicate[{tags non-empty}, $python_code {
def predicate(self):
    return len(self.get_tags().get_value()) >= 1
}]
  * $assert_09_doc_coverage_documented_within_total
      Predicate[{doc_coverage documented within total}, $python_code {
def predicate(self):
    return self.get_doc_coverage().get_value().get_documented_lines().value <= self.get_doc_coverage().get_value().get_total_lines().value
}]
