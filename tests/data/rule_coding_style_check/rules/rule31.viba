CodeLength := int
MaxLines := int
CoverageRatio := float
HasTests := bool
ModuleName := str
Keywords := list[str]
IntList := list[int]
Scores := dict[str, int]
NameSize := $name str * $size int
Triplet := $x int * $y int * $z int
DocCoverage := $documented_lines int * $total_lines int

Rule31 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $coverage_ratio Metric[CoverageRatio]
  * $has_tests Metric[HasTests]
  * $module_name Metric[ModuleName]
  * $keywords Metric[Keywords]
  * $int_list Metric[IntList]
  * $scores Metric[Scores]
  * $name_size Metric[NameSize]
  * $triplet Metric[Triplet]
  * $doc_coverage Metric[DocCoverage]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= 24
}]
  * $assert_02_code_length_not_above_max_lines
      Predicate[{code_length not above max_lines}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_max_lines().get_value().value
}]
  * $assert_03_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_04_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_05_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.get_has_tests().get_value().value
}]
  * $assert_06_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) <= 8
}]
  * $assert_07_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) >= 1
}]
  * $assert_08_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) >= 1
}]
  * $assert_09_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) <= 4
}]
  * $assert_10_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.get_scores().get_value()) >= 1
}]
  * $assert_11_scores_bounded
      Predicate[{scores bounded}, $python_code {
def predicate(self):
    return len(self.get_scores().get_value()) <= 4
}]
  * $assert_12_doc_coverage_documented_within_total
      Predicate[{doc_coverage documented within total}, $python_code {
def predicate(self):
    return self.get_doc_coverage().get_value().get_documented_lines().value <= self.get_doc_coverage().get_value().get_total_lines().value
}]
  * $assert_13_int_list_non_empty
      Predicate[{int_list non-empty}, $python_code {
def predicate(self):
    return len(self.get_int_list().get_value()) >= 1
}]
  * $assert_14_int_list_bounded
      Predicate[{int_list bounded}, $python_code {
def predicate(self):
    return len(self.get_int_list().get_value()) <= 4
}]
  * $assert_15_name_size_name_fits_size
      Predicate[{name_size name fits size}, $python_code {
def predicate(self):
    return len(self.get_name_size().get_value().get_name().value) <= self.get_name_size().get_value().get_size().value
}]
  * $assert_16_triplet_x_plus_y_within_z
      Predicate[{triplet x plus y within z}, $python_code {
def predicate(self):
    return self.get_triplet().get_value().get_x().value + self.get_triplet().get_value().get_y().value <= self.get_triplet().get_value().get_z().value
}]
