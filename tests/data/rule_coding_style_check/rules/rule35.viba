CyclomaticComplexity := int
ParamCount := int
CoverageRatio := float
ModuleName := str
Imports := list[str]
Lookup := dict[str, str]
IndentWidth := $spaces int

Rule35 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $param_count Metric[ParamCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $module_name Metric[ModuleName]
  * $imports Metric[Imports]
  * $lookup Metric[Lookup]
  * $indent_width Metric[IndentWidth]
  * $assert_00_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_01_param_count_at_most_24
      Predicate[{param_count at most 24}, $python_code {
def predicate(self):
    return self.param_count.value <= 24
}]
  * $assert_02_cyclomatic_complexity_not_above_param_count
      Predicate[{cyclomatic_complexity not above param_count}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= self.param_count.value
}]
  * $assert_03_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_04_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_05_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.module_name.value) <= 8
}]
  * $assert_06_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.module_name.value) >= 1
}]
  * $assert_07_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.imports.value) >= 1
}]
  * $assert_08_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.imports.value) <= 4
}]
  * $assert_09_indent_width_non_negative
      Predicate[{indent_width non-negative}, $python_code {
def predicate(self):
    return self.indent_width.spaces >= 0
}]
  * $assert_10_lookup_non_empty
      Predicate[{lookup non-empty}, $python_code {
def predicate(self):
    return len(self.lookup.value) >= 1
}]
  * $assert_11_lookup_bounded
      Predicate[{lookup bounded}, $python_code {
def predicate(self):
    return len(self.lookup.value) <= 4
}]
