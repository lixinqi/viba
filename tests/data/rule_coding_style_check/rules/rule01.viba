CodeLength := int
LoopCount := int
CyclomaticComplexity := int
TimeBudget := float
AuthorName := str

Rule01 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $loop_count Metric[LoopCount]
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $time_budget Metric[TimeBudget]
  * $author_name Metric[AuthorName]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.code_length.value <= 24
}]
  * $assert_01_code_length_under_100
      Predicate[{code_length under 100}, $python_code {
def predicate(self):
    return self.code_length.value < 100
}]
  * $assert_02_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.loop_count.value <= 24
}]
  * $assert_03_loop_count_under_100
      Predicate[{loop_count under 100}, $python_code {
def predicate(self):
    return self.loop_count.value < 100
}]
  * $assert_04_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value <= 24
}]
  * $assert_05_cyclomatic_complexity_under_100
      Predicate[{cyclomatic_complexity under 100}, $python_code {
def predicate(self):
    return self.cyclomatic_complexity.value < 100
}]
  * $assert_06_code_length_not_above_loop_count
      Predicate[{code_length not above loop_count}, $python_code {
def predicate(self):
    return self.code_length.value <= self.loop_count.value
}]
  * $assert_07_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.time_budget.value <= 50.5
}]
  * $assert_08_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.time_budget.value >= 0.0
}]
  * $assert_09_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.author_name.value) <= 8
}]
