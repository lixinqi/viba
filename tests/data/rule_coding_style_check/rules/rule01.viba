CodeLength := int
LoopCount := int
CyclomaticComplexity := int
TimeBudget := float
AuthorName := str

Rule01 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $loop_count Metric[LoopCount]
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $time_budget Metric[TimeBudget]
  * $author_name Metric[AuthorName]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.get_loop_count().get_value().value <= 24
}]
  * $assert_02_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.get_cyclomatic_complexity().get_value().value <= 24
}]
  * $assert_03_code_length_not_above_loop_count
      Predicate[{code_length not above loop_count}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_loop_count().get_value().value
}]
  * $assert_04_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value <= 50.5
}]
  * $assert_05_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value >= 0.0
}]
  * $assert_06_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) <= 8
}]
  * $assert_07_author_name_not_empty
      Predicate[{author_name not empty}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) >= 1
}]
