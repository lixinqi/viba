CodeLength := int
LoopCount := int
HasTests := bool
Keywords := list[str]
Scores := dict[str, int]
TraceLevel := $quiet () | $verbose ()

Rule08 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $loop_count Metric[LoopCount]
  * $has_tests Metric[HasTests]
  * $keywords Metric[Keywords]
  * $scores Metric[Scores]
  * $trace_level Metric[TraceLevel]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.code_length.value <= 24
}]
  * $assert_01_code_length_under_100
      Predicate[{code_length under 100}, $python_code {
def predicate(self):
    return self.code_length.value < 100
}]
  * $assert_02_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.loop_count.value <= 24
}]
  * $assert_03_loop_count_under_100
      Predicate[{loop_count under 100}, $python_code {
def predicate(self):
    return self.loop_count.value < 100
}]
  * $assert_04_code_length_not_above_loop_count
      Predicate[{code_length not above loop_count}, $python_code {
def predicate(self):
    return self.code_length.value <= self.loop_count.value
}]
  * $assert_05_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.has_tests.value
}]
  * $assert_06_has_tests_forbidden
      Predicate[{has_tests forbidden}, $python_code {
def predicate(self):
    return not self.has_tests.value
}]
  * $assert_07_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.keywords.value) >= 1
}]
  * $assert_08_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.keywords.value) <= 4
}]
  * $assert_09_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.scores.value) >= 1
}]
