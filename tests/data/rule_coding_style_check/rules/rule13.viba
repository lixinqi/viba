CodeLength := int
CyclomaticComplexity := int
CoverageRatio := float
BudgetSplit := $spent float * $cap float
ModuleName := str
Imports := list[str]
IsPublic := bool

Rule13 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $coverage_ratio Metric[CoverageRatio]
  * $budget_split Metric[BudgetSplit]
  * $module_name Metric[ModuleName]
  * $imports Metric[Imports]
  * $is_public Metric[IsPublic]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.get_cyclomatic_complexity().get_value().value <= 24
}]
  * $assert_02_code_length_not_above_cyclomatic_complexity
      Predicate[{code_length not above cyclomatic_complexity}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_cyclomatic_complexity().get_value().value
}]
  * $assert_03_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_04_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_05_is_public_required
      Predicate[{is_public required}, $python_code {
def predicate(self):
    return self.get_is_public().get_value().value
}]
  * $assert_06_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) <= 8
}]
  * $assert_07_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.get_module_name().get_value().value) >= 1
}]
  * $assert_08_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) >= 1
}]
  * $assert_09_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) <= 4
}]
