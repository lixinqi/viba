CodeLength := int
MaxLines := int
LoopCount := int
TimeBudget := float
HasTests := bool
DocCoverage := $documented_lines int * $total_lines int
Imports := list[str]
Scores := dict[str, int]
TraceLevel := $quiet () | $verbose ()

Rule17 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $loop_count Metric[LoopCount]
  * $time_budget Metric[TimeBudget]
  * $has_tests Metric[HasTests]
  * $doc_coverage Metric[DocCoverage]
  * $imports Metric[Imports]
  * $scores Metric[Scores]
  * $trace_level Metric[TraceLevel]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= 24
}]
  * $assert_02_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.get_loop_count().get_value().value <= 24
}]
  * $assert_03_code_length_not_above_max_lines
      Predicate[{code_length not above max_lines}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_max_lines().get_value().value
}]
  * $assert_04_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value <= 50.5
}]
  * $assert_05_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value >= 0.0
}]
  * $assert_06_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.get_has_tests().get_value().value
}]
  * $assert_07_imports_non_empty
      Predicate[{imports non-empty}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) >= 1
}]
  * $assert_08_imports_bounded
      Predicate[{imports bounded}, $python_code {
def predicate(self):
    return len(self.get_imports().get_value()) <= 4
}]
  * $assert_09_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.get_scores().get_value()) >= 1
}]
