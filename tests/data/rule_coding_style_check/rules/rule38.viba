CodeLength := int
MaxLines := int
LoopCount := int
CoverageRatio := float
TimeBudget := float
HasTests := bool
AuthorName := str
Keywords := list[str]
IntList := list[int]
IntPair := $a int * $b int
DocCoverage := $documented_lines int * $total_lines int

Rule38 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $loop_count Metric[LoopCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $time_budget Metric[TimeBudget]
  * $has_tests Metric[HasTests]
  * $author_name Metric[AuthorName]
  * $keywords Metric[Keywords]
  * $int_list Metric[IntList]
  * $int_pair Metric[IntPair]
  * $doc_coverage Metric[DocCoverage]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.get_max_lines().get_value().value <= 24
}]
  * $assert_02_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.get_loop_count().get_value().value <= 24
}]
  * $assert_03_code_length_not_above_max_lines
      Predicate[{code_length not above max_lines}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_max_lines().get_value().value
}]
  * $assert_04_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_05_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_06_time_budget_within_50_5
      Predicate[{time_budget within 50.5}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value <= 50.5
}]
  * $assert_07_time_budget_non_negative
      Predicate[{time_budget non-negative}, $python_code {
def predicate(self):
    return self.get_time_budget().get_value().value >= 0.0
}]
  * $assert_08_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.get_has_tests().get_value().value
}]
  * $assert_09_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) <= 8
}]
  * $assert_10_author_name_not_empty
      Predicate[{author_name not empty}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) >= 1
}]
  * $assert_11_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) >= 1
}]
  * $assert_12_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) <= 4
}]
  * $assert_13_doc_coverage_documented_within_total
      Predicate[{doc_coverage documented within total}, $python_code {
def predicate(self):
    return self.get_doc_coverage().get_value().get_documented_lines().value <= self.get_doc_coverage().get_value().get_total_lines().value
}]
  * $assert_14_int_list_non_empty
      Predicate[{int_list non-empty}, $python_code {
def predicate(self):
    return len(self.get_int_list().get_value()) >= 1
}]
  * $assert_15_int_list_bounded
      Predicate[{int_list bounded}, $python_code {
def predicate(self):
    return len(self.get_int_list().get_value()) <= 4
}]
  * $assert_16_int_pair_ordered
      Predicate[{int_pair ordered}, $python_code {
def predicate(self):
    return self.get_int_pair().get_value().get_a().value <= self.get_int_pair().get_value().get_b().value
}]
  * $assert_17_int_pair_sum_bounded
      Predicate[{int_pair sum bounded}, $python_code {
def predicate(self):
    return self.get_int_pair().get_value().get_a().value + self.get_int_pair().get_value().get_b().value <= 100
}]
