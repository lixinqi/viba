CyclomaticComplexity := int
IndentWidth := $spaces int
BudgetSplit := $spent float * $cap float
CoverageRatio := float
IsPublic := bool
AuthorName := str
Keywords := list[str]
Tags := set[str]

Rule16 :=
  RuleObject
  * $cyclomatic_complexity Metric[CyclomaticComplexity]
  * $indent_width Metric[IndentWidth]
  * $budget_split Metric[BudgetSplit]
  * $coverage_ratio Metric[CoverageRatio]
  * $is_public Metric[IsPublic]
  * $author_name Metric[AuthorName]
  * $keywords Metric[Keywords]
  * $tags Metric[Tags]
  * $assert_00_cyclomatic_complexity_at_most_24
      Predicate[{cyclomatic_complexity at most 24}, $python_code {
def predicate(self):
    return self.get_cyclomatic_complexity().get_value().value <= 24
}]
  * $assert_01_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_02_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_03_is_public_required
      Predicate[{is_public required}, $python_code {
def predicate(self):
    return self.get_is_public().get_value().value
}]
  * $assert_04_author_name_short
      Predicate[{author_name short}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) <= 8
}]
  * $assert_05_author_name_not_empty
      Predicate[{author_name not empty}, $python_code {
def predicate(self):
    return len(self.get_author_name().get_value().value) >= 1
}]
  * $assert_06_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) >= 1
}]
  * $assert_07_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) <= 4
}]
  * $assert_08_tags_bounded
      Predicate[{tags bounded}, $python_code {
def predicate(self):
    return len(self.get_tags().get_value()) <= 3
}]
  * $assert_09_tags_non_empty
      Predicate[{tags non-empty}, $python_code {
def predicate(self):
    return len(self.get_tags().get_value()) >= 1
}]
