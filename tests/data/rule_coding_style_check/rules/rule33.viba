CodeLength := int
LoopCount := int
CoverageRatio := float
HasTests := bool
Keywords := list[str]
Scores := dict[str, int]
IntPair := $a int * $b int

Rule33 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $loop_count Metric[LoopCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $has_tests Metric[HasTests]
  * $keywords Metric[Keywords]
  * $scores Metric[Scores]
  * $int_pair Metric[IntPair]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= 24
}]
  * $assert_01_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.get_loop_count().get_value().value <= 24
}]
  * $assert_02_code_length_not_above_loop_count
      Predicate[{code_length not above loop_count}, $python_code {
def predicate(self):
    return self.get_code_length().get_value().value <= self.get_loop_count().get_value().value
}]
  * $assert_03_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value <= 50.5
}]
  * $assert_04_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.get_coverage_ratio().get_value().value >= 0.0
}]
  * $assert_05_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.get_has_tests().get_value().value
}]
  * $assert_06_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) >= 1
}]
  * $assert_07_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.get_keywords().get_value()) <= 4
}]
  * $assert_08_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.get_scores().get_value()) >= 1
}]
  * $assert_09_scores_bounded
      Predicate[{scores bounded}, $python_code {
def predicate(self):
    return len(self.get_scores().get_value()) <= 4
}]
  * $assert_10_int_pair_ordered
      Predicate[{int_pair ordered}, $python_code {
def predicate(self):
    return self.get_int_pair().get_value().get_a().value <= self.get_int_pair().get_value().get_b().value
}]
  * $assert_11_int_pair_sum_bounded
      Predicate[{int_pair sum bounded}, $python_code {
def predicate(self):
    return self.get_int_pair().get_value().get_a().value + self.get_int_pair().get_value().get_b().value <= 100
}]
