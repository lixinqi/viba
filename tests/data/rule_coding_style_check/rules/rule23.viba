CodeLength := int
MaxLines := int
LoopCount := int
CoverageRatio := float
HasTests := bool
ModuleName := str
Keywords := list[str]
IntList := list[int]
Scores := dict[str, int]
Lookup := dict[str, str]
IntPair := $a int * $b int

Rule23 :=
  RuleObject
  * $code_length Metric[CodeLength]
  * $max_lines Metric[MaxLines]
  * $loop_count Metric[LoopCount]
  * $coverage_ratio Metric[CoverageRatio]
  * $has_tests Metric[HasTests]
  * $module_name Metric[ModuleName]
  * $keywords Metric[Keywords]
  * $int_list Metric[IntList]
  * $scores Metric[Scores]
  * $lookup Metric[Lookup]
  * $int_pair Metric[IntPair]
  * $assert_00_code_length_at_most_24
      Predicate[{code_length at most 24}, $python_code {
def predicate(self):
    return self.code_length.value <= 24
}]
  * $assert_01_max_lines_at_most_24
      Predicate[{max_lines at most 24}, $python_code {
def predicate(self):
    return self.max_lines.value <= 24
}]
  * $assert_02_loop_count_at_most_24
      Predicate[{loop_count at most 24}, $python_code {
def predicate(self):
    return self.loop_count.value <= 24
}]
  * $assert_03_code_length_not_above_max_lines
      Predicate[{code_length not above max_lines}, $python_code {
def predicate(self):
    return self.code_length.value <= self.max_lines.value
}]
  * $assert_04_coverage_ratio_within_50_5
      Predicate[{coverage_ratio within 50.5}, $python_code {
def predicate(self):
    return self.coverage_ratio.value <= 50.5
}]
  * $assert_05_coverage_ratio_non_negative
      Predicate[{coverage_ratio non-negative}, $python_code {
def predicate(self):
    return self.coverage_ratio.value >= 0.0
}]
  * $assert_06_has_tests_required
      Predicate[{has_tests required}, $python_code {
def predicate(self):
    return self.has_tests.value
}]
  * $assert_07_module_name_short
      Predicate[{module_name short}, $python_code {
def predicate(self):
    return len(self.module_name.value) <= 8
}]
  * $assert_08_module_name_not_empty
      Predicate[{module_name not empty}, $python_code {
def predicate(self):
    return len(self.module_name.value) >= 1
}]
  * $assert_09_keywords_non_empty
      Predicate[{keywords non-empty}, $python_code {
def predicate(self):
    return len(self.keywords.value) >= 1
}]
  * $assert_10_keywords_bounded
      Predicate[{keywords bounded}, $python_code {
def predicate(self):
    return len(self.keywords.value) <= 4
}]
  * $assert_11_scores_non_empty
      Predicate[{scores non-empty}, $python_code {
def predicate(self):
    return len(self.scores.value) >= 1
}]
  * $assert_12_scores_bounded
      Predicate[{scores bounded}, $python_code {
def predicate(self):
    return len(self.scores.value) <= 4
}]
  * $assert_13_int_list_non_empty
      Predicate[{int_list non-empty}, $python_code {
def predicate(self):
    return len(self.int_list.value) >= 1
}]
  * $assert_14_int_list_bounded
      Predicate[{int_list bounded}, $python_code {
def predicate(self):
    return len(self.int_list.value) <= 4
}]
  * $assert_15_lookup_non_empty
      Predicate[{lookup non-empty}, $python_code {
def predicate(self):
    return len(self.lookup.value) >= 1
}]
  * $assert_16_lookup_bounded
      Predicate[{lookup bounded}, $python_code {
def predicate(self):
    return len(self.lookup.value) <= 4
}]
  * $assert_17_int_pair_ordered
      Predicate[{int_pair ordered}, $python_code {
def predicate(self):
    return self.int_pair.a <= self.int_pair.b
}]
  * $assert_18_int_pair_sum_bounded
      Predicate[{int_pair sum bounded}, $python_code {
def predicate(self):
    return self.int_pair.a + self.int_pair.b <= 100
}]
