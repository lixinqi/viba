# rule.md 第 7 节示例的判定配套：pass 写 nil 对位，
# fail 同 tag 写 PredicationFailed（永不入围）。
DemoRuleStripped :=
  Object
  * $code_length Metric[CodeLength]
  * $assert_code_len_le_24 nil

DemoWitnessFail :=
  Object
  * $code_length ($value 30)
  * $assert_code_len_le_24 PredicationFailed[int, str]

DemoWitnessPass :=
  Object
  * $code_length ($value 20)
  * $assert_code_len_le_24 nil
