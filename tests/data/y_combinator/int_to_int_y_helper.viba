# int_to_int_y_helper.viba —— 自应用那一步：helper(f, y, n) = f(y(f, y), n)
#
# IntToIntYHelper 是这个模块当函数读时的类型。环境不写在这里：它是调用的规矩，
# 不是设计的一个参数，判定层也不把它算进类型。
__def__ =
    int
  <- $env Env
  <- $f ((int <- (int <- int)) <- int)
  <- $y_helper IntToIntYHelper
  <- $n int

args = __get_args__ << __def__

IntToIntYHelper =
    int
  <- $f (int <- (int <- int) <- int)
  <- $y_helper IntToIntYHelper
  <- $n int

# y(f, y)：只给两个实参、不给环境，停在半成品上 —— 这就是 eta 展开那一步
recursive =
    args.y_helper
  << $f args.f
  << $y_helper args.y_helper
# `$f` 那一格声明的是函数**类型**（类型里没有 tag），所以按位置给：先给那个半成品，
# 再按 tag 给 `$n` —— 参数的地址由收的那一方定，不由声明的那一方猜。
__ret__ =
    args.f
  << ($sub_env << args.env << "step")
  << recursive
  << $n args.n
