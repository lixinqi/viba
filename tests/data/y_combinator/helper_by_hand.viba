# helper_by_hand.viba —— 不经过 Y，直接把自应用那一步用起来，该答 55
#
# `y_helper` 就是那个 helper：它的 `__decl__` 要 `$f`（这一层的步）、`$y_helper`（它自己），
# 再要环境与这一层的实参积。要跑起来还差 `$f` 与 `$y_helper` 这两件，Y 替调用方写的就是这两件。
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

import fib_module
import y_helper

__impl__ =
    y_helper
  << $f fib_module
  << $y_helper y_helper
  << args.env
  << $n 10
