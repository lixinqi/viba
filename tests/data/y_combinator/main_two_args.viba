# main_two_args.viba —— 要跑的是 Y Two 3 4，该答 7
#
# 别名不叫 `F`，也不影响什么：`Y << Two` 收下的是那个模块本身。
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

import add2_module as Two
import Y

# 这一层的实参接着 `<<` 写（两个），`Y` 把它们收成一份积，`apply` 按成员个数选 apply_impl 那一支。
__impl__ = Y << Two << ($sub_env << args.env << "Y") << $n 3 << $m 4