# main_in_a_sub_env.viba —— 同一次 Y F 10，调用方自己给一层子环境，得 55
#
# `Y << F` 要环境，给哪一层由调用方定：这里给的是 `y` 这个名字下的一层子环境，
# 于是这次调用的数据路径是 `…/y`，而不是调用方脚下那一层。
__decl__ =
    int
  <- $env Env

args = __get_args__ << __decl__

import fib_module as F
import Y

__impl__ = Y << F << ($sub_env << args.env << "y") << $n 10
