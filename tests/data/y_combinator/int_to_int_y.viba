# int_to_int_y.viba —— Y：把 helper 交给自己，不动点就起来了
__def__ =
    int
  <- $env Env
  <- $f ((int <- (int <- int)) <- int)
  <- $n int

args = __get_args__ << __def__

import int_to_int_y_helper as helper

# helper 写在链头是一次调用，写在实参位置是它代表的那个闭包：
# 不动点就靠"把 helper 交给它自己"这一下；这一下只能落在调用里 —— 落成定义就是定义绕回自己。
__ret__ =
    helper
  << ($sub_env << args.env << "helper")
  << $f args.f
  << $y_helper helper
  << $n args.n
