# The step's helper: the step itself, this helper (the next layer), and the product of
# this layer's arguments. The environment is no parameter: the caller gives it with a
# `<<` of its own, and this call runs there.
#
# `$f` is the step as a value, whatever its parameter list looks like, so this one module
# answers every length; the arguments travel as one product and `apply` spreads it, so
# nothing here counts them either.
import apply

__decl__ =
    Any
  <- $f Any
  <- $y_helper Any
  <- $args ...

args = __get_args__ << __decl__

# y(f, y): with only those two and no environment, it stops partially applied — the eta
# step. Its head is the helper the caller handed over, which is this call itself.
recursive =
    args.y_helper
  << $f args.f
  << $y_helper args.y_helper

# The step is given the next layer; `apply` goes on giving this layer's arguments, and the
# environment reaches the step through the calls `apply` answers.
__impl__ = apply << (args.f << recursive) << args.args
