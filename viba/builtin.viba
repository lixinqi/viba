# Builtin library — visible from every module, lowest precedence:
# a custom module's own definitions and environment win.
#
# The environment a running module is handed (viba-interpreter.md). Read as
# a type, `environ` is an Environment — that is what a module's `$env` slot
# asks for; read as computation, it is the real environment. `Environment` is
# a function of the sub-environment's name, which is how a module call hands
# a module its own — and `$tmp_sub_env` is the same thing under a name nobody
# chose, fresh every call: `environ.tmp_sub_env << ()`. Its written argument
# is ignored (a call gives one, and `()` is how "nothing" is written), so any
# `()` does, and the shape says so by writing `()`.
Environment :=
    Object
  * $sub_env (Environment <- $sub_env_name str)
  * $tmp_sub_env (Environment <- ())

environ := Environment

# The host side of an environment. It is host vocabulary (the interpreter
# calls get_func; HostLanguageFunc is whatever that interpreter's functions
# are), so this file only states the shapes.
#
# The storage carries the run's snapshots as well as its paths: `store_root_dir`
# is where they are kept, `read_text` and `write_text` are the text under it.
# A snapshot is serialized viba data (viba-interpreter.md, "幂等与快照"), so a
# host function that is not pure can take one and the next run plays it back.
EnvironmentStorage :=
    Object
  * $store_root_dir str
  * $cur_storage_path str
  * $sub_storage (EnvironmentStorage <- $sub_storage_name str)
  * $read_text ($content str <- $file_path str)
  * $write_text (void <- $file_path str <- $content str)
  * {
      other storage information
    }

EnvironmentCompute :=
    Object
  * $get_func (HostLanguageFunc <- $module_path str <- $func_name str)
  * {
      get_func is called by interpret, and a module's sub-environment holds
      the parent's compute.
    }
