# Builtin library — visible from every module, lowest precedence:
# a custom module's own definitions and environment win.
#
# PredicationFailed marks a failed assertion in a witness. It is a
# plain nominal generic: it never seats in any Rule type, so a witness
# carrying it judges False against everything — no special machinery.
PredicationFailed[T, MsgStr] :=
  $__assertion_failed_original_data T
  * $__assertion_failed_error_msg MsgStr

# Metric[T] is the metric wrapper: the measured value sits under $value,
# so a witness writes `$len ($value 42)`. What the metric means — its
# data shape — lives entirely in T, a nominal type defined by the rule
# author.
Metric[T] :=
  $value T

# Predicate carries a natural-language condition (not executed) and an
# executable predicator under $python_code. It is stripped before
# judgment and never reaches is_sub_type.
Predicate[Cond, PythonCode] :=
  $assert_cond Cond * $assert_python_code PythonCode

# not[A] is never <- $not_operand A: a prohibition. A witness keeps the
# not[oneof] shell and swaps every branch leaf for the poison
# PredicationFailed; a branch left positive, or missing, judges False.
not[A] := never <- $not_operand A
