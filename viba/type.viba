# The Type universe consumed by is_sub_type (see viba/type.py).
# Oneof is never (sum identity); Object is nil (product identity;
# void and None are accepted aliases, canonicalized at parse).
# Everything structural stays at the ast.Ast layer and reaches the
# checker through $ast_node_type; this universe models leaves,
# references and the module machinery behind them.

Type :=
  Oneof
  | $never_type ()
  | $nil_type ()
  | $bool_type ()
  | $int_type ()
  | $float_type ()
  | $str_type ()
  | $bool_literal_type bool
  | $int_literal_type int
  | $float_literal_type float
  | $str_literal_type str
  | $ast_node_type AstNodeType
  | $module_type ModuleType

ModuleType :=
  Oneof
  | $builtin_module BuiltinModuleType
  | $custom_module CustomModuleType

CustomModuleType :=
  Object
  * $module ast.Module
  * $module_environment (Result[ModuleType] <- $module_name str)

AstNodeType :=
  Object
  * $ast_node ast.Ast
  * $container_module ModuleType
  * $env_get (Result[Type] <- $type_name str)

ModuleGetType :=
  Result[Type]
  <- $module ModuleType
  <- $type_name str

IsSubType :=
  Result[bool]
  <- $sub Type
  <- $sup Type
  <- Hint[{
    内部会用到 ModuleGetType：TypeRef 先经它在本模块解析；失败再
    沿 $env_get（自由名通道，内层绑定优先）查找——泛型实参等自由
    名的意义由此获得。两路都失败才是契约书写错误，整个判定
    Err（UnresolvedTypeError 在边界转为 Err）。
    指数参数交换模块时 env 随之交换：自由名永远经自己语法一侧的
    env_get 解析。
    AssertionViolated 不是特殊节点：它是内建库（viba/builtin.viba）
    里的普通名义泛型，sub 侧自然不入围（Ok(false)）；sup 侧按名字
    lint 出 Err。
    GenericDefinition 名义判定（同模块同名才相等）；TypeApp 两侧
    俱在时按名义：构造器相同再逐对比较实参。仅一侧 TypeApp 时
    结构展开：泛型体以 env_get 绑定形参-实参后参与比较（TypeRef
    实参在词法作用域即刻解析；常量/单位元实参直接绑为字面量
    类型）。展开按（节点, 实参语义）缓存，进行中的同键展开按共
    归纳假设为真，故递归泛型终止。AssertionViolated 不参与展开。
    TypeDefinition 透明展开、结构比较，递归对由假设表共归纳兜底。
    内建 list/set/dict 与其字面量构造器 ListLiteral/SetLiteral/
    DictLiteral 之间是居民关系而非名义相等：ListLiteral[a, b, c]
    是 list[a | b | c] 的居民（每个元素入席元素的并）；DictLiteral
    的 (k, v) 对分别入席键的并与值的并。反向与跨家族均为假。
    Ok(true/false) 是判定；Err 是 lint 错误：任何一侧出现
    ellipsis，或 AssertionViolated 出现在 sup 侧。
  }]
