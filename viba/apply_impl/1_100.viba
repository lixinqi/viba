# apply_impl, 1 argument: the product of arguments has 1 member,
# and each one is taken out of it by the tag the `pattern` line extracted.
pattern tagged[arg0_name, Arg0]

# The module's own signature: it answers whatever the function answers, and it takes
# the function and the product of arguments — the product comes as one piece, given
# `($a 1 * $b 2)` at the call site, which is what `$args Any` says. The call this file
# builds wants the environment too, and this file declares no `$env Env` parameter: the
# environment is appended to that call when this call's body answers it. What the
# product's members are is what the `pattern` line takes, not this.
__decl__ =
    Any
  <- $f Any
  <- $args Any

args = __get_args__ << __decl__

__impl__ =
    args.f
  << ($get_attr << $env nil << args.args << arg0_name)
