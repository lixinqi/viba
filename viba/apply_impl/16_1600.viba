# apply_impl, 16 arguments: the product of arguments has 16 members,
# and each one is taken out of it by the tag the `pattern` line extracted.
pattern tagged[arg0_name, Arg0] * tagged[arg1_name, Arg1] * tagged[arg2_name, Arg2] * tagged[arg3_name, Arg3] * tagged[arg4_name, Arg4] * tagged[arg5_name, Arg5] * tagged[arg6_name, Arg6] * tagged[arg7_name, Arg7] * tagged[arg8_name, Arg8] * tagged[arg9_name, Arg9] * tagged[arg10_name, Arg10] * tagged[arg11_name, Arg11] * tagged[arg12_name, Arg12] * tagged[arg13_name, Arg13] * tagged[arg14_name, Arg14] * tagged[arg15_name, Arg15]

# The module's own signature: it answers whatever the function answers, and it takes
# the function and the product of arguments — the product comes as one piece, given
# `($a 1 * $b 2)` at the call site, which is what `$args Any` says. The call this file
# builds wants the environment too, and this file declares no `$env Env` parameter: the
# environment is appended to that call when this call's body answers it. What the
# product's members are is what the `pattern` line takes, not this.
__decl__ =
    Any
  <- $f Any
  <- $args Any

args = __get_args__ << __decl__

__impl__ =
    args.f
  << ($get_attr << args.args << arg0_name)
  << ($get_attr << args.args << arg1_name)
  << ($get_attr << args.args << arg2_name)
  << ($get_attr << args.args << arg3_name)
  << ($get_attr << args.args << arg4_name)
  << ($get_attr << args.args << arg5_name)
  << ($get_attr << args.args << arg6_name)
  << ($get_attr << args.args << arg7_name)
  << ($get_attr << args.args << arg8_name)
  << ($get_attr << args.args << arg9_name)
  << ($get_attr << args.args << arg10_name)
  << ($get_attr << args.args << arg11_name)
  << ($get_attr << args.args << arg12_name)
  << ($get_attr << args.args << arg13_name)
  << ($get_attr << args.args << arg14_name)
  << ($get_attr << args.args << arg15_name)
