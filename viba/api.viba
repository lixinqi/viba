# The viba package's top-level API, written in viba: one definition per public
# function, the way viba/type.viba writes the type universe. It is a signature
# list — nothing here is implemented, nothing here judges, and the Comments
# blocks are units, so a reader that drops documentation reads only the shapes.
#
# Naming: the Python symbol sits in the English comment above each definition.
# A parameter that has a Python default is still written: viba has no defaults,
# and "can be left out" is what the comment says.

# ----------------------------------------------------------------------
# Syntax: viba.viba_ast
# ----------------------------------------------------------------------

# parse(source) -> Module
Parse := Module <- $source str <- Comments[{语法或词法错误时抛异常，不是 Result。}]

# unparse(tree) -> str
Unparse := str <- $tree Module

# unparse_type(node) -> str
UnparseType := str <- $node AST

# canonical(tree) -> Module
Canonical := Module <- $tree Module <- Comments[{压成链、并 $left/$result 一路，支链保留分组。}]

# dump(tree) -> str
Dump := str <- $tree Module

# walk(node) -> list[AST]
Walk := list[AST] <- $node AST

# convert_to_chain_style(node) -> AST
ToChain := AST <- $node AST <- Comments[{A * (B * C) 与 A * B * C 到这一步才同形。}]

# convert_from_chain_style(node) -> AST
FromChain := AST <- $node AST

# ----------------------------------------------------------------------
# Running a module: viba.interpreter
# ----------------------------------------------------------------------

# interpret(viba_main_file, environ, viba_path=None, get_file=None) -> Result[VibaNode]
Interpret :=
    Result[VibaNode]
  <- $viba_main_file str
  <- $environ Environment
  <- $viba_path str
  <- $get_file Optional[$file_content str <- $file_path str]
  <- Comments[{
      模块就是函数：environ 进，__ret__ 出。没有 __ret__ 的文件是设计，不是程序。
      interpret 不认识任何具体函数：实现全部来自 environ 的 compute 侧
      （get_func(module_path, func_name)），而且每个可执行函数都要依赖 environ。
      get_file 是源的来处：留空就读文件系统；给了就一律走它——返回文件的文本，
      那个路径上没有文件就返回 nil（或抛 FileNotFoundError）。路径按字符串给。
      每次模块调用要有自己的 storage 路径（它的身份），两次调用不许撞车：
      模块调用给一个子环境，environ.sub_env << ...；不想起名字就
      environ.tmp_sub_env << ()，每次一个新的。
    }]

# Environment := EnvironmentStorage * EnvironmentCompute，宿主侧的形状见
# viba/builtin.viba；sub_env 给子环境，子环境带着父级的 compute。

# 快照与回放：venv 结果要能回放，不纯的宿主函数把答案快照进 storage。
