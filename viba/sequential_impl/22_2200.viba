# sequential_impl, 22 steps: the steps product has 22 members — the first 21
# carries a tag, and the last one is given without a tag: its answer is the
# answer of the whole chain. One file per count, the way `apply_impl` gives one
# file per product size (viba-pattern.md): the tagged prefix is what pins the
# count, since a single bare name would answer any product at all.
pattern tagged[step0_name, Step0] * tagged[step1_name, Step1] * tagged[step2_name, Step2] * tagged[step3_name, Step3] * tagged[step4_name, Step4] * tagged[step5_name, Step5] * tagged[step6_name, Step6] * tagged[step7_name, Step7] * tagged[step8_name, Step8] * tagged[step9_name, Step9] * tagged[step10_name, Step10] * tagged[step11_name, Step11] * tagged[step12_name, Step12] * tagged[step13_name, Step13] * tagged[step14_name, Step14] * tagged[step15_name, Step15] * tagged[step16_name, Step16] * tagged[step17_name, Step17] * tagged[step18_name, Step18] * tagged[step19_name, Step19] * tagged[step20_name, Step20] * Last

__decl__ =
    Any
  <- $env Env
  <- $steps Any

args = __get_args__ << __decl__

# What the steps remember: the answer of every tagged step, given under its own
# tag, newest first — a product that carries one name twice answers with the member
# it carries first, so the newest one wins. The last argument carries no tag: its
# answer is what the chain answers, so it is remembered nowhere. Each step's member
# is piled on the product the step before kept (`vars2` is `tagged[step1_name,
# value1] * vars1`): a member that is a product contributes its own members, so what
# a step is handed is the flat product, newest first.

# Each step runs at a storage path of its own (`step0`, `step1`, ... and the last one
# at `last` beside them): a storage path answers one call, and two steps of one
# sequential would otherwise share it.

value0 = sequential_step[Step0]
  << $env ($sub_env << args.env << "step0")
  << $vars nil
vars1 = tagged[step0_name, value0]

value1 = sequential_step[Step1]
  << $env ($sub_env << args.env << "step1")
  << $vars vars1
vars2 = tagged[step1_name, value1] * vars1

value2 = sequential_step[Step2]
  << $env ($sub_env << args.env << "step2")
  << $vars vars2
vars3 = tagged[step2_name, value2] * vars2

value3 = sequential_step[Step3]
  << $env ($sub_env << args.env << "step3")
  << $vars vars3
vars4 = tagged[step3_name, value3] * vars3

value4 = sequential_step[Step4]
  << $env ($sub_env << args.env << "step4")
  << $vars vars4
vars5 = tagged[step4_name, value4] * vars4

value5 = sequential_step[Step5]
  << $env ($sub_env << args.env << "step5")
  << $vars vars5
vars6 = tagged[step5_name, value5] * vars5

value6 = sequential_step[Step6]
  << $env ($sub_env << args.env << "step6")
  << $vars vars6
vars7 = tagged[step6_name, value6] * vars6

value7 = sequential_step[Step7]
  << $env ($sub_env << args.env << "step7")
  << $vars vars7
vars8 = tagged[step7_name, value7] * vars7

value8 = sequential_step[Step8]
  << $env ($sub_env << args.env << "step8")
  << $vars vars8
vars9 = tagged[step8_name, value8] * vars8

value9 = sequential_step[Step9]
  << $env ($sub_env << args.env << "step9")
  << $vars vars9
vars10 = tagged[step9_name, value9] * vars9

value10 = sequential_step[Step10]
  << $env ($sub_env << args.env << "step10")
  << $vars vars10
vars11 = tagged[step10_name, value10] * vars10

value11 = sequential_step[Step11]
  << $env ($sub_env << args.env << "step11")
  << $vars vars11
vars12 = tagged[step11_name, value11] * vars11

value12 = sequential_step[Step12]
  << $env ($sub_env << args.env << "step12")
  << $vars vars12
vars13 = tagged[step12_name, value12] * vars12

value13 = sequential_step[Step13]
  << $env ($sub_env << args.env << "step13")
  << $vars vars13
vars14 = tagged[step13_name, value13] * vars13

value14 = sequential_step[Step14]
  << $env ($sub_env << args.env << "step14")
  << $vars vars14
vars15 = tagged[step14_name, value14] * vars14

value15 = sequential_step[Step15]
  << $env ($sub_env << args.env << "step15")
  << $vars vars15
vars16 = tagged[step15_name, value15] * vars15

value16 = sequential_step[Step16]
  << $env ($sub_env << args.env << "step16")
  << $vars vars16
vars17 = tagged[step16_name, value16] * vars16

value17 = sequential_step[Step17]
  << $env ($sub_env << args.env << "step17")
  << $vars vars17
vars18 = tagged[step17_name, value17] * vars17

value18 = sequential_step[Step18]
  << $env ($sub_env << args.env << "step18")
  << $vars vars18
vars19 = tagged[step18_name, value18] * vars18

value19 = sequential_step[Step19]
  << $env ($sub_env << args.env << "step19")
  << $vars vars19
vars20 = tagged[step19_name, value19] * vars19

value20 = sequential_step[Step20]
  << $env ($sub_env << args.env << "step20")
  << $vars vars20
vars21 = tagged[step20_name, value20] * vars20

# The last argument carries no tag: its answer is this chain's answer.
last = sequential_step[Last]
  << $env ($sub_env << args.env << "last")
  << $vars vars21

__impl__ = last
