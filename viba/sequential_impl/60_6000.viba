vars16 = tagged[step15_name, value15] * tagged[step14_name, value14] * tagged[step13_name, value13] * tagged[step12_name, value12] * tagged[step11_name, value11] * tagged[step10_name, value10] * tagged[step9_name, value9] * tagged[step8_name, value8] * tagged[step7_name, value7] * tagged[step6_name, value6] * tagged[step5_name, value5] * tagged[step4_name, value4] * tagged[step3_name, value3] * tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

