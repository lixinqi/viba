# sequential_impl, 60 steps: the steps product has 60 members — the first 59
# carries a tag, and the last one is written without a tag: its answer is the
# answer of the whole chain. One file per count, the way `apply_impl` writes one
# file per product size (viba-pattern.md): the tagged prefix is what pins the
# count, since a single bare name would answer any product at all.
pattern tagged[step0_name, Step0] * tagged[step1_name, Step1] * tagged[step2_name, Step2] * tagged[step3_name, Step3] * tagged[step4_name, Step4] * tagged[step5_name, Step5] * tagged[step6_name, Step6] * tagged[step7_name, Step7] * tagged[step8_name, Step8] * tagged[step9_name, Step9] * tagged[step10_name, Step10] * tagged[step11_name, Step11] * tagged[step12_name, Step12] * tagged[step13_name, Step13] * tagged[step14_name, Step14] * tagged[step15_name, Step15] * tagged[step16_name, Step16] * tagged[step17_name, Step17] * tagged[step18_name, Step18] * tagged[step19_name, Step19] * tagged[step20_name, Step20] * tagged[step21_name, Step21] * tagged[step22_name, Step22] * tagged[step23_name, Step23] * tagged[step24_name, Step24] * tagged[step25_name, Step25] * tagged[step26_name, Step26] * tagged[step27_name, Step27] * tagged[step28_name, Step28] * tagged[step29_name, Step29] * tagged[step30_name, Step30] * tagged[step31_name, Step31] * tagged[step32_name, Step32] * tagged[step33_name, Step33] * tagged[step34_name, Step34] * tagged[step35_name, Step35] * tagged[step36_name, Step36] * tagged[step37_name, Step37] * tagged[step38_name, Step38] * tagged[step39_name, Step39] * tagged[step40_name, Step40] * tagged[step41_name, Step41] * tagged[step42_name, Step42] * tagged[step43_name, Step43] * tagged[step44_name, Step44] * tagged[step45_name, Step45] * tagged[step46_name, Step46] * tagged[step47_name, Step47] * tagged[step48_name, Step48] * tagged[step49_name, Step49] * tagged[step50_name, Step50] * tagged[step51_name, Step51] * tagged[step52_name, Step52] * tagged[step53_name, Step53] * tagged[step54_name, Step54] * tagged[step55_name, Step55] * tagged[step56_name, Step56] * tagged[step57_name, Step57] * tagged[step58_name, Step58] * Last

__decl__ =
    Any
  <- $env Env
  <- $steps Any

args = __get_args__ << __decl__

# What the steps remember: the answer of every tagged step, written under its own
# tag, newest first — a product that carries one name twice answers with the member
# it carries first, so the newest one wins. The last argument carries no tag: its
# answer is what the chain answers, so it is remembered nowhere. The members are
# written out one by one instead of piled on the earlier product: a name standing
# for a product is no member of the product it is written into.

# Each step runs at an address of its own (`step0`, `step1`, ... and the last one
# at `last` beside them): a storage path answers one call, and two steps of one
# sequential would otherwise share it. `identity` is a call, so that environment
# is computed here rather than left as a writing.

value0 = sequential_step[Step0]
  << $env ($identity << ($sub_env << args.env << "step0"))
  << $vars nil
vars1 = tagged[step0_name, value0]

value1 = sequential_step[Step1]
  << $env ($identity << ($sub_env << args.env << "step1"))
  << $vars vars1
vars2 = tagged[step1_name, value1] * tagged[step0_name, value0]

value2 = sequential_step[Step2]
  << $env ($identity << ($sub_env << args.env << "step2"))
  << $vars vars2
vars3 = tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

value3 = sequential_step[Step3]
  << $env ($identity << ($sub_env << args.env << "step3"))
  << $vars vars3
vars4 = tagged[step3_name, value3] * tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

value4 = sequential_step[Step4]
  << $env ($identity << ($sub_env << args.env << "step4"))
  << $vars vars4
vars5 = tagged[step4_name, value4] * tagged[step3_name, value3] * tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

value5 = sequential_step[Step5]
  << $env ($identity << ($sub_env << args.env << "step5"))
  << $vars vars5
vars6 = tagged[step5_name, value5] * tagged[step4_name, value4] * tagged[step3_name, value3] * tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

value6 = sequential_step[Step6]
  << $env ($identity << ($sub_env << args.env << "step6"))
  << $vars vars6
vars7 = tagged[step6_name, value6] * tagged[step5_name, value5] * tagged[step4_name, value4] * tagged[step3_name, value3] * tagged[step2_name, value2] * tagged[step1_name, value1] * tagged[step0_name, value0]

