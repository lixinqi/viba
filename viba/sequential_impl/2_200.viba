# sequential_impl, 2 steps: the steps product has 2 members — the first 1
# carry a tag, and the last one is written without a tag: its answer is the
# answer of the whole chain. One file per count, the way `apply_impl` writes one
# file per product size (viba-pattern.md): the tagged prefix is what pins the
# count, since a single bare name would answer any product at all.
pattern tagged[step0_name, Step0] * Last

__decl__ =
    Any
  <- $env Env
  <- $steps Any

args = __get_args__ << __decl__

# What the steps remember: the answer of every tagged step, written under its own
# tag, newest first — a product that carries one name twice answers with the member
# it carries first, so the newest one wins. The last argument carries no tag: its
# answer is what the chain answers, so it is remembered nowhere. Each step's member
# is piled on the product the step before kept (`vars2` is `tagged[step1_name,
# value1] * vars1`): a member that is a product contributes its own members, so what
# a step is handed is the flat product, newest first.

# Each step runs at a storage path of its own (`step0`, `step1`, ... and the last one
# at `last` beside them): a storage path answers one call, and two steps of one
# sequential would otherwise share it.

value0 = sequential_step[Step0]
  << $env ($sub_env << args.env << "step0")
  << $vars nil
vars1 = tagged[step0_name, value0]

# The last argument carries no tag: its answer is this chain's answer.
last = sequential_step[Last]
  << $env ($sub_env << args.env << "last")
  << $vars vars1

__impl__ = last
