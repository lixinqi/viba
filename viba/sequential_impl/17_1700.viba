# sequential_impl, 17 steps: the steps product has 17 members — the first 16
# carries a tag, and the last one is given without a tag: its answer is the
# answer of the whole chain. One file per count, the way `apply_impl` gives one
# file per product size (viba-pattern.md): the tagged prefix is what pins the
# count, since a single bare name would answer any product at all.
pattern tagged[step0_name, Step0] * tagged[step1_name, Step1] * tagged[step2_name, Step2] * tagged[step3_name, Step3] * tagged[step4_name, Step4] * tagged[step5_name, Step5] * tagged[step6_name, Step6] * tagged[step7_name, Step7] * tagged[step8_name, Step8] * tagged[step9_name, Step9] * tagged[step10_name, Step10] * tagged[step11_name, Step11] * tagged[step12_name, Step12] * tagged[step13_name, Step13] * tagged[step14_name, Step14] * tagged[step15_name, Step15] * Last

__decl__ =
    Any
  <- $env Env
  <- $steps Any

args = __get_args__ << __decl__

# What the steps remember: the answer of every tagged step, given under its own
# tag, newest first — a product that carries one name twice answers with the member
# it carries first, so the newest one wins. The last argument carries no tag: its
# answer is what the chain answers, so it is remembered nowhere. Each step's member
# is piled on the product the step before kept (`vars2` is `tagged[step1_name,
# value1] * vars1`): a member that is a product contributes its own members, so what
# a step is handed is the flat product, newest first.

# Each step runs at a storage path of its own: `step0`, `step1`, ... for the ones
# that carry a tag, and `last` for the one given without a tag. The name says which
# call it is, too — the tag it carries and the function it names (`step0/a/add`,
# `last/echo`) — so a data path can be read back against the code. A storage path
# answers one call, and two steps of one sequential would otherwise share it.

value0 = sequential_step[Step0]
  << $env ($sub_env << args.env << ("step0" * step0_name * Step0))
  << $vars nil
vars1 = tagged[step0_name, value0]

value1 = sequential_step[Step1]
  << $env ($sub_env << args.env << ("step1" * step1_name * Step1))
  << $vars vars1
vars2 = tagged[step1_name, value1] * vars1

value2 = sequential_step[Step2]
  << $env ($sub_env << args.env << ("step2" * step2_name * Step2))
  << $vars vars2
vars3 = tagged[step2_name, value2] * vars2

value3 = sequential_step[Step3]
  << $env ($sub_env << args.env << ("step3" * step3_name * Step3))
  << $vars vars3
vars4 = tagged[step3_name, value3] * vars3

value4 = sequential_step[Step4]
  << $env ($sub_env << args.env << ("step4" * step4_name * Step4))
  << $vars vars4
vars5 = tagged[step4_name, value4] * vars4

value5 = sequential_step[Step5]
  << $env ($sub_env << args.env << ("step5" * step5_name * Step5))
  << $vars vars5
vars6 = tagged[step5_name, value5] * vars5

value6 = sequential_step[Step6]
  << $env ($sub_env << args.env << ("step6" * step6_name * Step6))
  << $vars vars6
vars7 = tagged[step6_name, value6] * vars6

value7 = sequential_step[Step7]
  << $env ($sub_env << args.env << ("step7" * step7_name * Step7))
  << $vars vars7
vars8 = tagged[step7_name, value7] * vars7

value8 = sequential_step[Step8]
  << $env ($sub_env << args.env << ("step8" * step8_name * Step8))
  << $vars vars8
vars9 = tagged[step8_name, value8] * vars8

value9 = sequential_step[Step9]
  << $env ($sub_env << args.env << ("step9" * step9_name * Step9))
  << $vars vars9
vars10 = tagged[step9_name, value9] * vars9

value10 = sequential_step[Step10]
  << $env ($sub_env << args.env << ("step10" * step10_name * Step10))
  << $vars vars10
vars11 = tagged[step10_name, value10] * vars10

value11 = sequential_step[Step11]
  << $env ($sub_env << args.env << ("step11" * step11_name * Step11))
  << $vars vars11
vars12 = tagged[step11_name, value11] * vars11

value12 = sequential_step[Step12]
  << $env ($sub_env << args.env << ("step12" * step12_name * Step12))
  << $vars vars12
vars13 = tagged[step12_name, value12] * vars12

value13 = sequential_step[Step13]
  << $env ($sub_env << args.env << ("step13" * step13_name * Step13))
  << $vars vars13
vars14 = tagged[step13_name, value13] * vars13

value14 = sequential_step[Step14]
  << $env ($sub_env << args.env << ("step14" * step14_name * Step14))
  << $vars vars14
vars15 = tagged[step14_name, value14] * vars14

value15 = sequential_step[Step15]
  << $env ($sub_env << args.env << ("step15" * step15_name * Step15))
  << $vars vars15
vars16 = tagged[step15_name, value15] * vars15

# The last argument carries no tag: its answer is this chain's answer.
last = sequential_step[Last]
  << $env ($sub_env << args.env << ("last" * Last))
  << $vars vars16

__impl__ = last
