pattern f9
pattern (Ret <- $env Env <- tagged[name0, A10_0] <- tagged[name1, A10_1])
pattern f10
pattern (Ret <- $env Env <- tagged[name0, A11_0] <- tagged[name1, A11_1])
pattern f11
pattern (Ret <- $env Env <- tagged[name0, A12_0] <- tagged[name1, A12_1])
pattern f12
pattern (Ret <- $env Env <- tagged[name0, A13_0] <- tagged[name1, A13_1])
pattern f13
pattern (Ret <- $env Env <- tagged[name0, A14_0] <- tagged[name1, A14_1])
pattern f14
pattern (Ret <- $env Env <- tagged[name0, A15_0] <- tagged[name1, A15_1])
pattern f15
pattern (Ret <- $env Env <- tagged[name0, A16_0] <- tagged[name1, A16_1])
pattern f16
pattern (Ret <- $env Env <- tagged[name0, A17_0] <- tagged[name1, A17_1])
pattern f17
pattern (Ret <- $env Env <- tagged[name0, A18_0] <- tagged[name1, A18_1])
pattern f18
pattern (Ret <- $env Env <- tagged[name0, A19_0] <- tagged[name1, A19_1])
pattern f19
pattern (Ret <- $env Env <- tagged[name0, A20_0] <- tagged[name1, A20_1])
pattern f20
pattern (Ret <- $env Env <- tagged[name0, A21_0] <- tagged[name1, A21_1])
pattern f21
pattern (Ret <- $env Env <- tagged[name0, A22_0] <- tagged[name1, A22_1])
pattern f22
pattern (Ret <- $env Env <- tagged[name0, A23_0] <- tagged[name1, A23_1])
pattern f23
pattern (Ret <- $env Env <- tagged[name0, A24_0] <- tagged[name1, A24_1])
pattern f24
pattern (Ret <- $env Env <- tagged[name0, A25_0] <- tagged[name1, A25_1])
pattern f25
pattern (Ret <- $env Env <- tagged[name0, A26_0] <- tagged[name1, A26_1])
pattern f26

__decl__ =
    Either[Ret, DispatchError]
  <- $env Env
  <- $args Any

args = __get_args__ << __decl__

value0 = $get_attr << args.args << $env args.env << name0
value1 = $get_attr << args.args << $env args.env << name1

type = Either[Ret, DispatchError] <- (A0_0 | A1_0 | A2_0 | A3_0 | A4_0 | A5_0 | A6_0 | A7_0 | A8_0 | A9_0 | A10_0 | A11_0 | A12_0 | A13_0 | A14_0 | A15_0 | A16_0 | A17_0 | A18_0 | A19_0 | A20_0 | A21_0 | A22_0 | A23_0 | A24_0 | A25_0 | A26_0) <- (A0_1 | A1_1 | A2_1 | A3_1 | A4_1 | A5_1 | A6_1 | A7_1 | A8_1 | A9_1 | A10_1 | A11_1 | A12_1 | A13_1 | A14_1 | A15_1 | A16_1 | A17_1 | A18_1 | A19_1 | A20_1 | A21_1 | A22_1 | A23_1 | A24_1 | A25_1 | A26_1)
ret = Ret
arg0 = A0_0 | A1_0 | A2_0 | A3_0 | A4_0 | A5_0 | A6_0 | A7_0 | A8_0 | A9_0 | A10_0 | A11_0 | A12_0 | A13_0 | A14_0 | A15_0 | A16_0 | A17_0 | A18_0 | A19_0 | A20_0 | A21_0 | A22_0 | A23_0 | A24_0 | A25_0 | A26_0
arg1 = A0_1 | A1_1 | A2_1 | A3_1 | A4_1 | A5_1 | A6_1 | A7_1 | A8_1 | A9_1 | A10_1 | A11_1 | A12_1 | A13_1 | A14_1 | A15_1 | A16_1 | A17_1 | A18_1 | A19_1 | A20_1 | A21_1 | A22_1 | A23_1 | A24_1 | A25_1 | A26_1
arg_name0 = name0
arg_name1 = name1

func_arg_types = ListLiteral[
    (A0_0 * A0_1),
    (A1_0 * A1_1),
    (A2_0 * A2_1),
    (A3_0 * A3_1),
    (A4_0 * A4_1),
    (A5_0 * A5_1),
    (A6_0 * A6_1),
    (A7_0 * A7_1),
    (A8_0 * A8_1),
    (A9_0 * A9_1),
    (A10_0 * A10_1),
    (A11_0 * A11_1),
    (A12_0 * A12_1),
    (A13_0 * A13_1),
    (A14_0 * A14_1),
    (A15_0 * A15_1),
    (A16_0 * A16_1),
    (A17_0 * A17_1),
    (A18_0 * A18_1),
    (A19_0 * A19_1),
    (A20_0 * A20_1),
    (A21_0 * A21_1),
    (A22_0 * A22_1),
    (A23_0 * A23_1),
    (A24_0 * A24_1),
    (A25_0 * A25_1),
    (A26_0 * A26_1)
]

index =
    get_first_impl_case_index
  << (args.env.sub_env << args.env << "index")
  << $args args.args
  << $func_arg_types func_arg_types

takes0 = __is_sub_type_value__ << index << 0
takes1 = __is_sub_type_value__ << index << 1
takes2 = __is_sub_type_value__ << index << 2
takes3 = __is_sub_type_value__ << index << 3
takes4 = __is_sub_type_value__ << index << 4
takes5 = __is_sub_type_value__ << index << 5
takes6 = __is_sub_type_value__ << index << 6
takes7 = __is_sub_type_value__ << index << 7
takes8 = __is_sub_type_value__ << index << 8
takes9 = __is_sub_type_value__ << index << 9
takes10 = __is_sub_type_value__ << index << 10
takes11 = __is_sub_type_value__ << index << 11
takes12 = __is_sub_type_value__ << index << 12
takes13 = __is_sub_type_value__ << index << 13
takes14 = __is_sub_type_value__ << index << 14
takes15 = __is_sub_type_value__ << index << 15
takes16 = __is_sub_type_value__ << index << 16
takes17 = __is_sub_type_value__ << index << 17
takes18 = __is_sub_type_value__ << index << 18
takes19 = __is_sub_type_value__ << index << 19
takes20 = __is_sub_type_value__ << index << 20
takes21 = __is_sub_type_value__ << index << 21
takes22 = __is_sub_type_value__ << index << 22
takes23 = __is_sub_type_value__ << index << 23
takes24 = __is_sub_type_value__ << index << 24
takes25 = __is_sub_type_value__ << index << 25
takes26 = __is_sub_type_value__ << index << 26

__impl__ =
    if
  << $env (args.env.sub_env << args.env << "select")
  << $cond takes0
  << $t (f0 << value0 << value1)
  << $f (if
    << $cond takes1
    << $t (f1 << value0 << value1)
    << $f (if
      << $cond takes2
      << $t (f2 << value0 << value1)
      << $f (if
        << $cond takes3
        << $t (f3 << value0 << value1)
        << $f (if
          << $cond takes4
          << $t (f4 << value0 << value1)
          << $f (if
            << $cond takes5
            << $t (f5 << value0 << value1)
            << $f (if
              << $cond takes6
              << $t (f6 << value0 << value1)
              << $f (if
                << $cond takes7
                << $t (f7 << value0 << value1)
                << $f (if
                  << $cond takes8
                  << $t (f8 << value0 << value1)
                  << $f (if
                    << $cond takes9
                    << $t (f9 << value0 << value1)
                    << $f (if
                      << $cond takes10
                      << $t (f10 << value0 << value1)
                      << $f (if
                        << $cond takes11
                        << $t (f11 << value0 << value1)
                        << $f (if
                          << $cond takes12
                          << $t (f12 << value0 << value1)
                          << $f (if
                            << $cond takes13
                            << $t (f13 << value0 << value1)
                            << $f (if
                              << $cond takes14
                              << $t (f14 << value0 << value1)
                              << $f (if
                                << $cond takes15
                                << $t (f15 << value0 << value1)
                                << $f (if
                                  << $cond takes16
                                  << $t (f16 << value0 << value1)
                                  << $f (if
                                    << $cond takes17
                                    << $t (f17 << value0 << value1)
                                    << $f (if
                                      << $cond takes18
                                      << $t (f18 << value0 << value1)
                                      << $f (if
                                        << $cond takes19
                                        << $t (f19 << value0 << value1)
                                        << $f (if
                                          << $cond takes20
                                          << $t (f20 << value0 << value1)
                                          << $f (if
                                            << $cond takes21
                                            << $t (f21 << value0 << value1)
                                            << $f (if
                                              << $cond takes22
                                              << $t (f22 << value0 << value1)
                                              << $f (if
                                                << $cond takes23
                                                << $t (f23 << value0 << value1)
                                                << $f (if
                                                  << $cond takes24
                                                  << $t (f24 << value0 << value1)
                                                  << $f (if
                                                    << $cond takes25
                                                    << $t (f25 << value0 << value1)
                                                    << $f (if
                                                      << $cond takes26
                                                      << $t (f26 << value0 << value1)
                                                      << $f dispatch_error))))))))))))))))))))))))))
