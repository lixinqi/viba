# 2 handlers, 8 parameters: the call.
#
# Each handler is given twice: the first pattern takes its type apart
# (the parameter types, and the names the parameters go by), the second
# is the handler itself, which is what the call runs. The index of the
# first handler whose parameter product takes the arguments comes from
# `get_first_impl_case_index`; no handler takes them, the answer is
# `dispatch_error`.
import get_first_impl_case_index
import dispatch_error

pattern (Ret <- $env Env <- tagged[name0, A0_0] <- tagged[name1, A0_1] <- tagged[name2, A0_2] <- tagged[name3, A0_3] <- tagged[name4, A0_4] <- tagged[name5, A0_5] <- tagged[name6, A0_6] <- tagged[name7, A0_7])
pattern f0
pattern (Ret <- $env Env <- tagged[name0, A1_0] <- tagged[name1, A1_1] <- tagged[name2, A1_2] <- tagged[name3, A1_3] <- tagged[name4, A1_4] <- tagged[name5, A1_5] <- tagged[name6, A1_6] <- tagged[name7, A1_7])
pattern f1

__decl__ =
    Either[Ret, DispatchError]
  <- $env Env
  <- $args Any

args = __get_args__ << __decl__

value0 = $get_attr << args.args << $env args.env << name0
value1 = $get_attr << args.args << $env args.env << name1
value2 = $get_attr << args.args << $env args.env << name2
value3 = $get_attr << args.args << $env args.env << name3
value4 = $get_attr << args.args << $env args.env << name4
value5 = $get_attr << args.args << $env args.env << name5
value6 = $get_attr << args.args << $env args.env << name6
value7 = $get_attr << args.args << $env args.env << name7

type = Either[Ret, DispatchError] <- (A0_0 | A1_0) <- (A0_1 | A1_1) <- (A0_2 | A1_2) <- (A0_3 | A1_3) <- (A0_4 | A1_4) <- (A0_5 | A1_5) <- (A0_6 | A1_6) <- (A0_7 | A1_7)
ret = Ret
arg0 = A0_0 | A1_0
arg1 = A0_1 | A1_1
arg2 = A0_2 | A1_2
arg3 = A0_3 | A1_3
arg4 = A0_4 | A1_4
arg5 = A0_5 | A1_5
arg6 = A0_6 | A1_6
arg7 = A0_7 | A1_7
arg_name0 = name0
arg_name1 = name1
arg_name2 = name2
arg_name3 = name3
arg_name4 = name4
arg_name5 = name5
arg_name6 = name6
arg_name7 = name7

func_arg_types = ListLiteral[
    (A0_0 * A0_1 * A0_2 * A0_3 * A0_4 * A0_5 * A0_6 * A0_7),
    (A1_0 * A1_1 * A1_2 * A1_3 * A1_4 * A1_5 * A1_6 * A1_7)
]

index =
    get_first_impl_case_index
  << (args.env.sub_env << args.env << "index")
  << $args args.args
  << $func_arg_types func_arg_types

takes0 = __is_sub_type_value__ << index << 0
takes1 = __is_sub_type_value__ << index << 1

__impl__ =
    if
  << $env (args.env.sub_env << args.env << "select")
  << $cond takes0
  << $t (f0 << value0 << value1 << value2 << value3 << value4 << value5 << value6 << value7)
  << $f (if
    << $cond takes1
    << $t (f1 << value0 << value1 << value2 << value3 << value4 << value5 << value6 << value7)
    << $f dispatch_error)
