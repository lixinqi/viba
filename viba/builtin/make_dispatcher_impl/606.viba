# 6 handlers, 6 parameters: the call.
#
# Each handler is given twice: the first pattern takes its type apart
# (the parameter types, and the names the parameters go by), the second
# is the handler itself, which is what the call runs. The index of the
# first handler whose parameter product takes the arguments comes from
# `get_first_impl_case_index`; no handler takes them, the answer is
# `dispatch_error`.
import get_first_impl_case_index
import dispatch_error

pattern (Ret <- $env Env <- tagged[name0, A0_0] <- tagged[name1, A0_1] <- tagged[name2, A0_2] <- tagged[name3, A0_3] <- tagged[name4, A0_4] <- tagged[name5, A0_5])
pattern f0
pattern (Ret <- $env Env <- tagged[name0, A1_0] <- tagged[name1, A1_1] <- tagged[name2, A1_2] <- tagged[name3, A1_3] <- tagged[name4, A1_4] <- tagged[name5, A1_5])
pattern f1
pattern (Ret <- $env Env <- tagged[name0, A2_0] <- tagged[name1, A2_1] <- tagged[name2, A2_2] <- tagged[name3, A2_3] <- tagged[name4, A2_4] <- tagged[name5, A2_5])
pattern f2
pattern (Ret <- $env Env <- tagged[name0, A3_0] <- tagged[name1, A3_1] <- tagged[name2, A3_2] <- tagged[name3, A3_3] <- tagged[name4, A3_4] <- tagged[name5, A3_5])
pattern f3
pattern (Ret <- $env Env <- tagged[name0, A4_0] <- tagged[name1, A4_1] <- tagged[name2, A4_2] <- tagged[name3, A4_3] <- tagged[name4, A4_4] <- tagged[name5, A4_5])
pattern f4
pattern (Ret <- $env Env <- tagged[name0, A5_0] <- tagged[name1, A5_1] <- tagged[name2, A5_2] <- tagged[name3, A5_3] <- tagged[name4, A5_4] <- tagged[name5, A5_5])
pattern f5

__decl__ =
    Either[Ret, DispatchError]
  <- $env Env
  <- $args Any

args = __get_args__ << __decl__

value0 = $get_attr << args.args << $env args.env << name0
value1 = $get_attr << args.args << $env args.env << name1
value2 = $get_attr << args.args << $env args.env << name2
value3 = $get_attr << args.args << $env args.env << name3
value4 = $get_attr << args.args << $env args.env << name4
value5 = $get_attr << args.args << $env args.env << name5

type = Either[Ret, DispatchError] <- (A0_0 | A1_0 | A2_0 | A3_0 | A4_0 | A5_0) <- (A0_1 | A1_1 | A2_1 | A3_1 | A4_1 | A5_1) <- (A0_2 | A1_2 | A2_2 | A3_2 | A4_2 | A5_2) <- (A0_3 | A1_3 | A2_3 | A3_3 | A4_3 | A5_3) <- (A0_4 | A1_4 | A2_4 | A3_4 | A4_4 | A5_4) <- (A0_5 | A1_5 | A2_5 | A3_5 | A4_5 | A5_5)
ret = Ret
arg0 = A0_0 | A1_0 | A2_0 | A3_0 | A4_0 | A5_0
arg1 = A0_1 | A1_1 | A2_1 | A3_1 | A4_1 | A5_1
arg2 = A0_2 | A1_2 | A2_2 | A3_2 | A4_2 | A5_2
arg3 = A0_3 | A1_3 | A2_3 | A3_3 | A4_3 | A5_3
arg4 = A0_4 | A1_4 | A2_4 | A3_4 | A4_4 | A5_4
arg5 = A0_5 | A1_5 | A2_5 | A3_5 | A4_5 | A5_5
arg_name0 = name0
arg_name1 = name1
arg_name2 = name2
arg_name3 = name3
arg_name4 = name4
arg_name5 = name5

func_arg_types = ListLiteral[
    (A0_0 * A0_1 * A0_2 * A0_3 * A0_4 * A0_5),
    (A1_0 * A1_1 * A1_2 * A1_3 * A1_4 * A1_5),
    (A2_0 * A2_1 * A2_2 * A2_3 * A2_4 * A2_5),
    (A3_0 * A3_1 * A3_2 * A3_3 * A3_4 * A3_5),
    (A4_0 * A4_1 * A4_2 * A4_3 * A4_4 * A4_5),
    (A5_0 * A5_1 * A5_2 * A5_3 * A5_4 * A5_5)
]

index =
    get_first_impl_case_index
  << (args.env.sub_env << args.env << "index")
  << $args args.args
  << $func_arg_types func_arg_types

takes0 = __is_sub_type_value__ << index << 0
takes1 = __is_sub_type_value__ << index << 1
takes2 = __is_sub_type_value__ << index << 2
takes3 = __is_sub_type_value__ << index << 3
takes4 = __is_sub_type_value__ << index << 4
takes5 = __is_sub_type_value__ << index << 5

__impl__ =
    if
  << $env (args.env.sub_env << args.env << "select")
  << $cond takes0
  << $t (f0 << value0 << value1 << value2 << value3 << value4 << value5)
  << $f (if
    << $cond takes1
    << $t (f1 << value0 << value1 << value2 << value3 << value4 << value5)
    << $f (if
      << $cond takes2
      << $t (f2 << value0 << value1 << value2 << value3 << value4 << value5)
      << $f (if
        << $cond takes3
        << $t (f3 << value0 << value1 << value2 << value3 << value4 << value5)
        << $f (if
          << $cond takes4
          << $t (f4 << value0 << value1 << value2 << value3 << value4 << value5)
          << $f (if
            << $cond takes5
            << $t (f5 << value0 << value1 << value2 << value3 << value4 << value5)
            << $f dispatch_error)))))
