# unclosure: the closure a call with exactly 16 given
# arguments and no environment is. `f` is the api it is
# of, and `captured` is those arguments as one product — one file per
# length, the way `apply_impl` gives one file per product size.
pattern F << A0 << A1 << A2 << A3 << A4 << A5 << A6 << A7 << A8 << A9 << A10 << A11 << A12 << A13 << A14 << A15

f = F
captured = (A0 * A1 * A2 * A3 * A4 * A5 * A6 * A7 * A8 * A9 * A10 * A11 * A12 * A13 * A14 * A15)
