# sequential_step: a step given as a call with 2 tagged
# arguments. Every argument is answered first — a `$var "x"` inside
# one becomes the value that name holds — and the call then runs at a child of
# this environment (`run` beside it), so the step and the call it makes never
# share one storage path. Each argument is answered at a child named by its own
# number, since two answers are two calls.
pattern F << tagged[arg0_name, Arg0] << tagged[arg1_name, Arg1]

__decl__ =
    Any
  <- $env Env
  <- $vars Any

args = __get_args__ << __decl__

answered0 = tree_apply_closure_only_without_env[Arg0] << $env ($sub_env << args.env << "arg0") << $vars args.vars << $of Arg0
answered1 = tree_apply_closure_only_without_env[Arg1] << $env ($sub_env << args.env << "arg1") << $vars args.vars << $of Arg1

__impl__ =
    apply
  << $f F
  << $args (tagged[arg0_name, answered0] * tagged[arg1_name, answered1])
  << $env ($sub_env << args.env << "run")
