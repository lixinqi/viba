# sequential_step: a step given as a call with 1 tagged
# argument. Every argument is answered first — a `$var "x"` inside
# one becomes the value that name holds — and the call then runs at a child of
# this environment (`run` beside it), so the step and the call it makes never
# share one storage path. Each argument is answered at a child of its own,
# named by where it stands, the tag it carries and the function it names
# (`arg0/a/mul`): two answers are two calls, and a data path can be read back
# against the code.
pattern F << tagged[arg0_name, Arg0]

__decl__ =
    Any
  <- $env Env
  <- $vars Any

args = __get_args__ << __decl__

answered0 = tree_apply_closure_only_without_env[Arg0] << $env ($sub_env << args.env << ("arg0" * arg0_name * Arg0)) << $vars args.vars << $of Arg0

__impl__ =
    apply
  << $f F
  << $args (tagged[arg0_name, answered0])
  << $env ($sub_env << args.env << "run")
