# sequential_step: a step given as a call with 5 tagged
# arguments. Every argument is answered first — a `$var "x"` inside
# one becomes the value that name holds — and the call then runs at a child of
# this environment (`run` beside it), so the step and the call it makes never
# share one storage path. Each argument is answered at a child named by its own
# number, since two answers are two calls.
pattern F << tagged[arg0_name, Arg0] << tagged[arg1_name, Arg1] << tagged[arg2_name, Arg2] << tagged[arg3_name, Arg3] << tagged[arg4_name, Arg4]

__decl__ =
    Any
  <- $env Env
  <- $vars Any

args = __get_args__ << __decl__

answered0 = sequential_arg[Arg0] << $env ($sub_env << args.env << "arg0") << $vars args.vars
answered1 = sequential_arg[Arg1] << $env ($sub_env << args.env << "arg1") << $vars args.vars
answered2 = sequential_arg[Arg2] << $env ($sub_env << args.env << "arg2") << $vars args.vars
answered3 = sequential_arg[Arg3] << $env ($sub_env << args.env << "arg3") << $vars args.vars
answered4 = sequential_arg[Arg4] << $env ($sub_env << args.env << "arg4") << $vars args.vars

__impl__ =
    apply
  << $f F
  << $args (tagged[arg0_name, answered0] * tagged[arg1_name, answered1] * tagged[arg2_name, answered2] * tagged[arg3_name, answered3] * tagged[arg4_name, answered4])
  << $env ($sub_env << args.env << "run")
