# sequential_arg: the argument a step's closure gave is a variable reference
# (`$a ($var "x")`), so what goes to the closure is the value that name holds at
# the time this step runs.
pattern $var X

__decl__ =
    Any
  <- $env Env
  <- $vars Any

args = __get_args__ << __decl__

__impl__ = $get_attr << args.vars << X
