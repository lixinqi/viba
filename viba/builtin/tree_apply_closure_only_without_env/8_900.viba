# tree_apply_closure_only_without_env: a call that was given 8 tagged
# arguments. Each argument is answered as its own tree first — a `$var "x"`
# becomes the value that name holds, and a call inside it is run in turn — and the
# call then runs at a child of this environment (`run` beside it), so a call and
# the calls it makes never share one storage path. Each argument is answered at a
# child named by its own number, since two answers are two calls.
#
# `$of` is this argument itself, given along so that this same file used one level
# deeper is a different call.
pattern F << tagged[arg0_name, Arg0] << tagged[arg1_name, Arg1] << tagged[arg2_name, Arg2] << tagged[arg3_name, Arg3] << tagged[arg4_name, Arg4] << tagged[arg5_name, Arg5] << tagged[arg6_name, Arg6] << tagged[arg7_name, Arg7]

__decl__ =
    Any
  <- $env Env
  <- $vars Any
  <- $of Any

args = __get_args__ << __decl__

answered0 = tree_apply_closure_only_without_env[Arg0] << $env ($sub_env << args.env << "arg0") << $vars args.vars << $of Arg0
answered1 = tree_apply_closure_only_without_env[Arg1] << $env ($sub_env << args.env << "arg1") << $vars args.vars << $of Arg1
answered2 = tree_apply_closure_only_without_env[Arg2] << $env ($sub_env << args.env << "arg2") << $vars args.vars << $of Arg2
answered3 = tree_apply_closure_only_without_env[Arg3] << $env ($sub_env << args.env << "arg3") << $vars args.vars << $of Arg3
answered4 = tree_apply_closure_only_without_env[Arg4] << $env ($sub_env << args.env << "arg4") << $vars args.vars << $of Arg4
answered5 = tree_apply_closure_only_without_env[Arg5] << $env ($sub_env << args.env << "arg5") << $vars args.vars << $of Arg5
answered6 = tree_apply_closure_only_without_env[Arg6] << $env ($sub_env << args.env << "arg6") << $vars args.vars << $of Arg6
answered7 = tree_apply_closure_only_without_env[Arg7] << $env ($sub_env << args.env << "arg7") << $vars args.vars << $of Arg7

__impl__ =
    apply
  << $f F
  << $args (tagged[arg0_name, answered0] * tagged[arg1_name, answered1] * tagged[arg2_name, answered2] * tagged[arg3_name, answered3] * tagged[arg4_name, answered4] * tagged[arg5_name, answered5] * tagged[arg6_name, answered6] * tagged[arg7_name, answered7])
  << $env ($sub_env << args.env << "run")
