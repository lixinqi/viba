# The Metric layer's constraints: what a metric field is made of, and what a
# metric function must fit. metric.md reads them and carries the worked example.
#
# Result and JsonLike are the shapes reflect already reads. MetricFuncInterface
# is what a metric function must fit. Metric[CoreFunc] is the metric object: the
# reserved tag is its nominal anchor, $func is the design's function, and
# $call_instance is the call that was measured.
#
# A metric function ends with Hint[$python_code {...}], whose metric_func entry
# is the code that actually runs. The Hint carries documentation, so a judgment
# drops it from the argument list.

Result[T] :=
    Oneof
  | $ok T
  | $err str

JsonLike :=
    Oneof
  | nil
  | bool
  | int
  | float
  | str
  | list[JsonLike]
  | set[JsonLike]
  | dict[str, JsonLike]

MetricFuncInterface := Result[JsonLike] <- never

# The object's nominal anchor: not a business field.
# yanatuttn = you_are_not_allowed_to_use_this_tag_name
MetricObject := Object * $__metric_object_yanatuttn__ nil

Metric[CoreFunc] :=
    MetricObject
  * $func CoreFunc
  * $call_instance (Result[JsonLike] <- CoreFunc)
  * Appendix[{
      CoreFunc <: (Result[JsonLike] <- never)
      When the evidence is fixed, CoreFunc's arguments and result must be
      written as real values.
    }]
