# The prepared calls this demo's evidence carries: the victim, the suspect and
# the moment are fixed, the result position keeps the declared type. It depends
# on viba/rule/metric.viba; the witnesses depend on this file.
#
# The evidence keeps one of these in the metric object's $call_instance argument
# slot, so the call instance reads as
#   $call_instance . by_field_index(0)  the value metric_func answers for it
#   $call_instance . by_field_index(1)  the prepared call itself
#
# Two calls, because the metric answers 5 for one and 3 for the other - the
# value is the code's, not the evidence's: metric_func over (0,0) and (3,4) is
# ((0-3)^2 + (0-4)^2)^0.5 = 5, and over (0,0) and (0,3) it is 3.

import viba.rule.metric as metric

Prepare :=
    metric.Result[int]
  <- $victim ($x 0 * $y 0)
  <- $suspect ($x 3 * $y 4)
  <- $at "12:30"

PrepareNear :=
    metric.Result[int]
  <- $victim ($x 0 * $y 0)
  <- $suspect ($x 0 * $y 3)
  <- $at "12:30"
