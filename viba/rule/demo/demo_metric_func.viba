# The demo's metric function: how far apart the victim and the suspect were at
# a moment. It depends on viba/rule/metric.viba, whose names it refers to as
# metric.* (the import names it metric).
#
# Verdicts (tests/test_rule_demo.py):
#   GetDistance <: MetricFuncInterface        => Ok(True)
#   check_tag_and_inline(metric.viba + demo)  => Ok(None)

import viba.rule.metric as metric

# demo: a point and a moment
PersonPoint := ($x int * $y int)
Moment := str

# definition: victim, suspect, moment -> the distance between them.
# The trailing Hint is the code that actually runs; its entry is metric_func.
GetDistance :=
    metric.Result[int]
  <- $victim PersonPoint
  <- $suspect PersonPoint
  <- $at Moment
  <- Hint[$python_code {
def metric_func(victim, suspect, at):
    return ((victim.get_x().value - suspect.get_x().value) ** 2
            + (victim.get_y().value - suspect.get_y().value) ** 2) ** 0.5
}]

# `<<` gives one written argument, so this is the same measurement with the
# moment already given: a function of the two points.
GetDistanceAt1230 := GetDistance << $at "12:30"

# Giving every argument leaves the result itself - which is what the prepared
# call declares at its result position.
GetDistanceDone :=
    GetDistance
  << $at "12:30"
  << $victim PersonPoint
  << $suspect PersonPoint
