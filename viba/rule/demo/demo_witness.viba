# The evidence for demo_rule. Each witness carries one prepared call and the
# value metric_func answers for it: $ok 5 over demo_prepare.Prepare (victim
# (0,0), suspect (3,4)) and $ok 3 over demo_prepare.PrepareNear (victim (0,0),
# suspect (0,3)). The value is the code's - the witness only records it, and
# tests/test_rule_demo.py runs metric_func to check the record. It depends on
# all four files above.
#
# Verdicts (tests/test_rule_demo.py):
#   DemoWitnessPass   <: DemoRule  => Ok(True)
#   DemoWitnessLow    <: DemoRule  => Ok(True) as written: a Predicate field is
#                                     a type to compare, so a positive witness
#                                     judges True until its code runs
#   reset_predication_by_python_code(DemoWitnessLow, DemoRule)
#                     <: DemoRule  => Ok(False): the code ran, 3 < 5, and the
#                                     layer wrote the poison where the
#                                     Predicate was - which is DemoWitnessFailed
#   DemoWitnessFailed <: DemoRule  => Ok(False)
#   reset_predication_by_python_code(DemoWitnessPass, DemoRule)
#                     <: DemoRule  => Ok(True): 5 >= 5, nothing flips

import viba.rule.metric as metric
import viba.rule.demo.demo_metric_func as demo_metric_func
import viba.rule.demo.demo_prepare as demo_prepare
import viba.rule.demo.demo_rule as demo_rule

# The nearer pair: metric_func answers 3, one short of the threshold
DemoWitnessLow :=
    $distance (
        Object
        * $__metric_object_yanatuttn__ nil
        * $func demo_metric_func.GetDistance
        * $call_instance (metric.Result[3] <- demo_prepare.PrepareNear)
      )
  * $assert_distance_ge_5
      Predicate[{the distance is at least 5}, $python_code {
def predicate(self):
    return self.get_distance().get_call_instance().get_field_0().get_ok().value >= 5
}]

# the farther pair: metric_func answers 5, and 5 >= 5 holds
DemoWitnessPass :=
    $distance (
        Object
        * $__metric_object_yanatuttn__ nil
        * $func demo_metric_func.GetDistance
        * $call_instance (metric.Result[5] <- demo_prepare.Prepare)
      )
  * $assert_distance_ge_5
      Predicate[{the distance is at least 5}, $python_code {
def predicate(self):
    return self.get_distance().get_call_instance().get_field_0().get_ok().value >= 5
}]

# DemoWitnessLow after its code ran: the poison where the Predicate was
DemoWitnessFailed :=
    $distance (
        Object
        * $__metric_object_yanatuttn__ nil
        * $func demo_metric_func.GetDistance
        * $call_instance (metric.Result[3] <- demo_prepare.PrepareNear)
      )
  * $assert_distance_ge_5 PredicationFailed[nil, str]
