# The 1-argument branch: the same wiring, with 1 argument in the argument list.
#
# `Ret` the result, `Env` the environment, `F` the next computation, `Arg0` argument;
# Tag symbols (`env_name`, `arg0_name`) are extracted from the actual arguments;
# so this file knows no name but `$env`, and no result, function or argument types.
pattern Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0]

YHelper =
    Ret
  <- $f (Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0])
  <- $y_helper YHelper
  <- $env Env
  <- __tagged__[arg0_name, Arg0]

# Each layer reads the chain as written: a name, even one pointing at the same chain,
# is not "the call this application stands for" to them, so the signature is written out again.
__decl__ =
    Ret
  <- $f (Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0])
  <- $y_helper YHelper
  <- $env Env
  <- __tagged__[arg0_name, Arg0]

args = __get_args__ << __decl__

# y(f, y): with only those two and no environment, it stops partially applied — the eta step.
recursive =
    args.y_helper
  << $f args.f
  << $y_helper args.y_helper
# The argument is fetched by its own tag: that tag is an extracted symbol, hence `$__getattr__`.
__impl__ =
    args.f
  << ($sub_env << args.env << "step")
  << recursive
  << ($__getattr__ << args << arg0_name)
