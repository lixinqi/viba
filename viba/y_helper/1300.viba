# The 13-argument branch: the same wiring, with 13 arguments in the argument list.
#
# `Ret` the result, `Env` the environment, `F` the next computation, `Arg0`…`Arg12` arguments;
# Tag symbols (`env_name`, `arg0_name`…`arg12_name`) are extracted from the actual arguments;
# so this file knows no name but `$env`, and no result, function or argument types.
pattern Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0] <- __tagged__[arg1_name, Arg1] <- __tagged__[arg2_name, Arg2] <- __tagged__[arg3_name, Arg3] <- __tagged__[arg4_name, Arg4] <- __tagged__[arg5_name, Arg5] <- __tagged__[arg6_name, Arg6] <- __tagged__[arg7_name, Arg7] <- __tagged__[arg8_name, Arg8] <- __tagged__[arg9_name, Arg9] <- __tagged__[arg10_name, Arg10] <- __tagged__[arg11_name, Arg11] <- __tagged__[arg12_name, Arg12]

YHelper =
    Ret
  <- $f (Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0] <- __tagged__[arg1_name, Arg1] <- __tagged__[arg2_name, Arg2] <- __tagged__[arg3_name, Arg3] <- __tagged__[arg4_name, Arg4] <- __tagged__[arg5_name, Arg5] <- __tagged__[arg6_name, Arg6] <- __tagged__[arg7_name, Arg7] <- __tagged__[arg8_name, Arg8] <- __tagged__[arg9_name, Arg9] <- __tagged__[arg10_name, Arg10] <- __tagged__[arg11_name, Arg11] <- __tagged__[arg12_name, Arg12])
  <- $y_helper YHelper
  <- $env Env
  <- __tagged__[arg0_name, Arg0]
  <- __tagged__[arg1_name, Arg1]
  <- __tagged__[arg2_name, Arg2]
  <- __tagged__[arg3_name, Arg3]
  <- __tagged__[arg4_name, Arg4]
  <- __tagged__[arg5_name, Arg5]
  <- __tagged__[arg6_name, Arg6]
  <- __tagged__[arg7_name, Arg7]
  <- __tagged__[arg8_name, Arg8]
  <- __tagged__[arg9_name, Arg9]
  <- __tagged__[arg10_name, Arg10]
  <- __tagged__[arg11_name, Arg11]
  <- __tagged__[arg12_name, Arg12]

# Each layer reads the chain as written: a name, even one pointing at the same chain,
# is not "the call this application stands for" to them, so the signature is written out again.
__decl__ =
    Ret
  <- $f (Ret <- __tagged__[env_name, Env] <- F <- __tagged__[arg0_name, Arg0] <- __tagged__[arg1_name, Arg1] <- __tagged__[arg2_name, Arg2] <- __tagged__[arg3_name, Arg3] <- __tagged__[arg4_name, Arg4] <- __tagged__[arg5_name, Arg5] <- __tagged__[arg6_name, Arg6] <- __tagged__[arg7_name, Arg7] <- __tagged__[arg8_name, Arg8] <- __tagged__[arg9_name, Arg9] <- __tagged__[arg10_name, Arg10] <- __tagged__[arg11_name, Arg11] <- __tagged__[arg12_name, Arg12])
  <- $y_helper YHelper
  <- $env Env
  <- __tagged__[arg0_name, Arg0]
  <- __tagged__[arg1_name, Arg1]
  <- __tagged__[arg2_name, Arg2]
  <- __tagged__[arg3_name, Arg3]
  <- __tagged__[arg4_name, Arg4]
  <- __tagged__[arg5_name, Arg5]
  <- __tagged__[arg6_name, Arg6]
  <- __tagged__[arg7_name, Arg7]
  <- __tagged__[arg8_name, Arg8]
  <- __tagged__[arg9_name, Arg9]
  <- __tagged__[arg10_name, Arg10]
  <- __tagged__[arg11_name, Arg11]
  <- __tagged__[arg12_name, Arg12]

args = __get_args__ << __decl__

# y(f, y): with only those two and no environment, it stops partially applied — the eta step.
recursive =
    args.y_helper
  << $f args.f
  << $y_helper args.y_helper
# The argument is fetched by its own tag: that tag is an extracted symbol, hence `$__getattr__`.
__impl__ =
    args.f
  << ($sub_env << args.env << "step")
  << recursive
  << ($__getattr__ << args << arg0_name)
  << ($__getattr__ << args << arg1_name)
  << ($__getattr__ << args << arg2_name)
  << ($__getattr__ << args << arg3_name)
  << ($__getattr__ << args << arg4_name)
  << ($__getattr__ << args << arg5_name)
  << ($__getattr__ << args << arg6_name)
  << ($__getattr__ << args << arg7_name)
  << ($__getattr__ << args << arg8_name)
  << ($__getattr__ << args << arg9_name)
  << ($__getattr__ << args << arg10_name)
  << ($__getattr__ << args << arg11_name)
  << ($__getattr__ << args << arg12_name)
